;NAME "@1:BASIC4EF4B.M04";**********************************;*                                *;* REST OF INTERRUPT ROUTINE;     *;* DO CURSOR BLINK.               *;*                                *;**********************************E458 LDA BLNSW ;IF CURSOR INVISIBLE BNE KEY4 ;SKIP BLINK HANDLING DEC BLNCT ;DECREMENT COUNTDOWN BNE KEY4 ;IF COUNTDOWN LDA #20 ;SET NEW COUNTDOWN BIT RPTFLG ;IF REPEAT BPL E469 LDA #2 ;SET SHORTER COUNTDOWNE469 STA BLNCT LDY PNTR ;GET COLUMN POSITION LSR BLNON ;DETERMINE BLINK PHASE ;AND SET PHASE ZERO LDA (PNT),Y ;GET CHARACTER AT CURRENT POSITION BCS KEY5 ;IF IN PHASE ZERO INC BLNON ;SET BLINK PHASE ONE STA GDBLN ;AND STORE TRUE CHARACTERKEY5 EOR #$80 ;REVERSE SCREEN CHARACTER STA (PNT),Y ;AND PUT TO SCREEN;**********************************;*                                *;* CASSETTE MOTOR CONTROL.        *;*                                *;**********************************KEY4 LDY #$00 ;PREPARE FOR KEYBOARD SCAN LDA PIAL AND #$F0 ;SET ZERO IN STA PIAL ;KEYBOARD SCAN LINE NUMBER LDA PIAL ;GET CASSETTE SENSE LINES ASL A ;IN BIT 7 ASL A ;AND CARRY ASL A BPL KEY3 ;IF NO KEY DOWN ON CASSETTE 1 STY CAS1 ;FLAG CASSETTE 1 OFF LDA PIAS ORA #$08 ;AND SWITCH MOTOR OFF BNE KL24 ;AND TEST CASS#2KEY3 LDA CAS1 ;KEY DOWN,IF #1 FLAG ON BNE KL2 ;TEST CASS#2 LDA PIAS ;ELSE AND #$F7 ;START CASS#1 MOTORKL24 STA PIASKL2 BCC KL23 ;IF NO KEY DOWN ON CASS.#2 STY CAS2 ;FLAG CASS.#2 OFF LDA PIA ORA #$10 ;AND SWITCH CASS#2 MOTOR OFF BNE KL25KL23 LDA CAS2 ;KEY DOWN,IF #2 FLAG ON BNE E4B9 ;FINISH CASSETTE CONTROL LDA PIA ;ELSE AND #$EF ;SWITCH #2 MOTOR ONKL25 STA PIAE4B9 JSR E4BF ;HANDLE KEYBOARD JMP PREND ;AND RETURN FROM INTERRUPT;**********************************;*                                *;* KEYBOARD HANDLING.             *;*                                *;**********************************E4BF LDY #$FF ;THIS INDEX RECEIVED STY SFDX ;ON NO KEY AT ALL INY STY SHFLAG ;CLEAR SHIFT KEY INDICATOR LDA RPTFLG ;GET REPEAT FLAG AND #$7F ;ZERO MSB STA RPTFLG LDX #80 ;THIS NUMBER OF KEYS TO BE DONEKL22 LDY #8 ;NUMBER OF ROWS LDA PIAK ;GET KEY IMAGE CMP PIAK ;WAIT BNE KL22 ;UNTIL STEADY CMP #$FF ;IF NO KEY BNE KL1 TXA ;MOVE INDEX SEC SBC #$08 ;SUBTRACT EIGHT ;BUG: WRONG RESULT IF IRQ ENTERED ;     WITH DECIMAL FLAG SET. TAX ;MOVE IT BACK BNE E511 ;AND TRY NEXT SCAN LINE BEQ CKIT1 ;IF ALL KEYS TRIED, HANDLE REPEATKL1 LSR A ;KEY PRESSED, GET BIT BCS CKIT ;IF KEY FOUND (BIT=0) PHA ;SAVE A LDA CHAR-1,X ;GET CHAR. FROM TABLE BNE CKIS2 ;IF ZERO LDA #1 ;INDICATE STA SHFLAG ;SHIFT-KEY FOUND BNE CKUT ;AND CHECK NEXT BITSCKIS2 CMP #$10 ;IF REPEAT-KEY PRESSED BNE CKIS1 ;(LEFT-OVER FROM BUSINESS VERSION) LDA RPTFLG ;GET FLAG BYTE ORA #$80 ;SET REPEAT ON STA RPTFLG ;STORE IT BMI CKUT ;AND GO REPEATCKIS1 CMP #$FF ;IF LEGAL KEY BEQ CKUT STA SFDX ;STORE ITCKUT PLA ;RESTORE KEY IMAGECKIT DEX ;TRY NEXT KEY BEQ CKIT1 ;IF ALL DONE, HANDLE REPEAT DEY ;ADAPT BIT COUNTER BNE KL1 ;IF NOT ALL DONE, LOOPE511 INC PIAL ;CHECK NEXT SCAN LINE BNE KL22CKIT1 LDA SFDX ;GET KEY FOUND CMP LSTX ;IF SAME AS LAST TIME BEQ E523 ;GO DO REPEAT LDX #$10 ;ELSE STORE COUNTDOWN STX DELAY BNE E556 ;AND EXITE523 BIT RPTFLG ;GET REPEAT FLAG BMI E548 ;IF REPEAT PRESSED, GO REPEAT BVS E587 ;IF REPEAT OFF, EXIT CMP #$FF ;IF NO KEY BEQ E587 ;EXIT CMP #$14 ;IF INST/DEL BEQ E53E ;DO REPEAT CMP #$20 ;IF SPACE BEQ E53E ;DO REPEAT CMP #$1D ;IF LEFT/RIGHT BEQ E53E ;DO REPEAT CMP #$11 ;IF NOT UP/DOWN BNE E587 ;EXITE53E LDX DELAY ;GET DELAY BEQ E548 ;IF EXPIRED, LOAD COUNTDOWN DEC DELAY ;ELSE DELAY BNE E587 ;AND EXITE548 DEC KOUNT ;DECREMENT COUNTDOWN BNE E587 ;IF NOT EXPIRED, EXIT LDX #4 ;ELSE STX KOUNT ;RELOAD COUNTDOWN LDX NDX ;GET # OF KEYS IN BUFFER BNE E587 ;IF NOT EMPTY, EXITE556 STA LSTX ;ELSE STORE NEW VALUE CMP #$FF ;IF NO KEY BEQ E587 ;EXIT TAX ;SAVE KEY IN X PHP ;SAVE FLAGS AND #$7F ;REMOVE SHIFT BIT PLP ;GET FLAGS AGAINE561 BMI KN1 ;IF MSBIT WAS SET, IGNORE MSBIT LSR SHFLAG ;GET AND CLEAR SHIFT STATUS BCC KN1 ;IF PRESSED AND CMP #',' ;IF LOWER THAN COMMA ;(CONCERNS ALL CTL. CHARS. AND SPACE) BCC E561 ;ADD SHIFTBIT CMP #'<' ;OR HIGHER THAN ; ;(CONCERNS ALL LETTERS) BCS E561 ;ADD SHIFTBIT AS WELL SBC #$0F ;ELSE CONVERT CHAR. TO SHIFTED VALUE ;BUG: WRONG RESULT IF IRQ ENTERED ;     WITH DECIMAL FLAG SET. ;(CONCERNS ,-./ NUMBERS :;) CMP #$20 ;IF NOW HIGHER THAN SPACE BCS KN1 ;PUT IN BUFFER ADC #$20 ;ELSE CONVERT TO SHIFT VALUE ;BUG: WRONG RESULT IF IRQ ENTERED ;     WITH DECIMAL FLAG SET. .BYT $2C ;SKIP NEXT INSTRUCTION ORA #$80 ;ADD SHIFT BITKN1 LDX NDX ;GET # OF KEYS IN BUFFER CPX XMAX ;IF MORE THAN MAX. BUFFER LENGTH BCS E587 ;EXIT (IGNORE KEY) ;BUG: EXITS ON EQUALITY, NOT IF MORE, ;     SO DEFAULT 9, ACCEPTS 9 KEYS MAXIMUM, ;     NOT TEN. STA KEYD,X ;ELSE STORE IN BUFFER INX STX NDX ;AND ADAPT BUFFER COUNTERE587 RTS;**********************************;*                                *;* SET ZERO FLAG IF NOT AT        *;* TAB-STOP.                      *;*                                *;**********************************E588 TYA ;GET POSITION IN A AND #$07 ;GET LOWEST 3 BITS TAX ;MOVE TO INDEX LDA E7DC,X ;GET BIT MASK FROM TABLE STA $03EF ;STORE IT TYA ;GET POSITION AGAIN LSR A LSR A LSR A ;DIVIDE BY EIGHT TAX ;MOVE TO INDEX LDA $03F0,X ;GET BYTE WITH TABSTOPS BIT $03EF ;SET ZERO FLAG IF NOT AT TABSTOP RTS ;