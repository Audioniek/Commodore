;NAME "@1:BASIC4EG8.M01";**********************************;*                                *;* JUMP MENU, ENABLES STANDARDI-  *;* SATION BETWEEN VARIOUS MACHINE *;* TYPES.                         *;*                                *;**********************************JCINT JMP CINT ;INITIALIZE I/O, CURSOR HOME AND 4 BELLSJLP2 JMP LP2 ;GET CHARACTER FROM KEYBOARD BUFFERJLOOP5 JMP LOOP5 ;GET CHARACTER FROM DEVICE 0 OR 3JPRT JMP PRT ;PUT CHARACTER TO SCREENJPULS JMP PULS ;SERVICE INTERRUPTJKEY JMP KEY ;DEFAULT INTERRUPT ROUTINEJPREND JMP PREND ;EXIT FROM INTERRUPTJCLSR JMP CLSR ;CLEAR SCREEN WITHIN WINDOWJTXCRT JMP TXCRT ;SET TO LOWER/UPPER CASEJGRCRT JMP GRCRT ;SET TO UPPER CASE/GRAPHICSJCSET JMP CRTSET ;OTHER CRT CONTROLLER SETTINGSJSCRDN JMP SCRDWN ;SCROLL SCREEN DOWNJSCRUP JMP SCRUP ;SCROLL SCREEN UPJKYCN JMP KEYSCN ;FIND KEY FROM DECODING TABLEJBELL JMP BELL ;RING BELL ONCEJFUT1 JMP FUT001 ;STORE ACCU IN REPEAT FLAGJMP TOPLF ;SET TOP LEFT OF WINDOWJMP BOTRT ;SET RIGHT BOTTOM OF WINDOW;**********************************;*                                *;* STORE A IN REPEATFLAG (NOT     *;* USED).                         *;*                                *;**********************************FUT001 STA RPTFLG ;STORE A IN REPEAT FLAG RTS; * = $E04B ;FIXED ADDRESS IN F-ROM;**********************************;*                                *;* RESET ROUTINE.                 *;*                                *;**********************************CINT JSR EXTRA0 ;INITIALIZE I/O AND ZERO PAGE JSR GRCRT ;SET CRT CONTROLLER TO UPPER CASE/GRAPHICS;**********************************;*                                *;* INITIALIZE SCREEN; CLEAR       *;* SCREEN WITHIN WINDOW.          *;*                                *;**********************************CLSR LDX SCTOP ;GET TOP LINE # OF WINDOW DEXCLS10 INX ;DO NEXT LINE JSR STUPR ;GET POINTER TO LINE JSR CLRLN ;ERASE THAT LINE TILL END OF WINDOW CPX SCBOT ;UNTIL BOTTOM OF WINDOW DONE BCC CLS10;**********************************;*                                *;* HOME CURSOR (WITHIN WINDOW).   *;*                                *;**********************************NXTD LDX SCTOP ;GET TOP LINE # OF WINDOW STX TBLX ;SET CURSOR ON THAT LINESTU10 LDY SCLF ;GET LEFT MARGIN OF WINDOW STY PNTR ;SET CURSOR THERESTUPT LDX TBLX ;GET LINE # AGAIN JMP SCRSET ;AND GET POINTER TO LINESTUPR LDY SCLF ;GET LEFT MARGIN OF WINDOW DEY;**********************************;*                                *;* GET POINTER TO CURRENT SCREEN  *;* LINE.                          *;*                                *;**********************************SCRSET LDA LDTB2,X ;GET LO-BYTE OF PNTR STA PNT ;STORE IN POINTER LDA LDTB1,X ;GET HI-BYTE STA PNT+1 ;AND COMPLETE POINTER RTS;**********************************;*                                *;* SET CRT CONTROLLER TO TEXT     *;* MODE.                          *;*                                *;**********************************TXCRT LDA #<TEXT ;GET LO-BYTE OF POINTER LDX #>TEXT ;AND HI-BYTE ALSOOF POINTER LDY #$0E ;AND GET LO-NIBBLE FOR VIA BNE CRTSET ;AND SET UP CRT CONTROLLER;**********************************;*                                *;* SET CRT CONTROLLER TO GRAPHICS *;* MODE.                          *;*                                *;**********************************GRCRT LDA #<GRAF ;GET LO-BYTE OF POINTER LDX #>GRAF ;AND HI-BYTE ALSOOF POINTER LDY #$0C ;AND GET LO-NIBBLE FOR VIA;**********************************;*                                *;* SET CRT CONTROLLER.            *;*                                *;**********************************CRTSET STA SAL ;STORE POINTER STX SAH LDA PCR ;GET VIA REGISTER AND #$F0 ;CLEAR LO-NIBBLE STA FNLEN ;AND SAVE IT TYA ;GET LO-NIBBLE ORA FNLEN ;ADD TO REGISTER VALUE STA PCR ;AND SET UP CHARACTERGENERATOR LDY #17 ;MOVE 18 CONSTANTSCRT10 LDA (SAL),Y ;GET CONSTANT FROM TABLE STY CR0 ;SELECT CRTC REGISTER STA CR1 ;AND MOVE CONSTANT DEY ;AND DO NEXT REGISTER BPL CRT10 ;UNTIL ALL DONE RTS  * =$E0A7 ;FIXED ADDRESS IN F-ROM;**********************************;*                                *;* GET CHARACTER FROM KEYBOARD    *;* BUFFER.                        *;*                                *;**********************************LP2 LDY KEYBUF ;GET OLDEST CHARACTER LDX #$00LP1 LDA KEYBUF+1,X ;MOVE REST OF BUFFER STA KEYBUF,X ;FOREWARD INX CPX KBFPTR ;UNTIL ALL CHAR'S DONE BNE LP1 DEC KBFPTR ;ADAPT INDEX IN BUFFER TYA ;GET CHARACTER IN ACCU CLI ;ENABLE INTERRUPTS AGAIN RTS ;AND EXIT;**********************************;*                                *;* WAIT FOR RETURN FROM KEYBOARD. *;*                                *;**********************************LOOP4 JSR PATCH2 ;ECHO CHARACTER ON SCREENLOOP3 LDA KBFPTR ;GET INDEX IN KEYB. BUFFER STA BLNSW ;IF EMPTY, SET CURSOR VISIBLE BEQ LOOP3 ;ELSE WAIT FOR CHARACTER SEI ;DISABLE INTERRUPTS LDA BLNON ;IF BLINK FASE ONE BEQ LP21 LDA GDBLN ;GET TRUE CHAR. AT CURSOR POSITION LDY #$00 STY BLNON ;SET BLINK FASE ZERO JSR DSPP ;AND PUT CHAR TO SCREENLP21 JSR LP2 ;GET CHARACTER FROM BUFFER CMP #$83 ;IF SHIFT-STOP BNE LP22 SEI ;DISABLE INTERRUPTS LDX #9 ;MOVE TEN CHARACTERS STX KBFPTR ;SET INDEX IN BUFFER TO 9LP23 LDA RUNTB-1,X ;MOVE STANDARD STRING STA KEYBUF-1,X ;TO BUFFER DEX BNE LP23 BEQ LOOP3 ;AND GET 1ST CHAR. OF THATLP22 CMP #$0D ;IF IS NOT RETURN BNE LOOP4 ;GO ECHO TO SCREEN AND GET NEXT CHAR. LDY SCRT ;ELSE GET MAX. LENGTH STY CRSW ;FLAG INPUT FROM SCREENCLP5 LDA (PNT),Y ;GET CHAR. FROM SCREEN CMP #$20 ;IF SPACE AT END OF LINE BNE CLP6 DEY ;GET PREVIOUS CHARACTER BNE CLP5CLP6 INY STY INDX ;SET RECORD LENGTH OF CURRENT LINE JSR PATCH1 ;SET CURSOR ON LEFT MARGIN NOP ;(RETURNS WITH Y ZERO) STY QTSW ;CLEAR QUOTE FLAG LDA LXSP ;GET LINE NUMBER ON SCREEN BMI LOP5 ;IF VALID CMP TBLX ;AND EQUAL TO ORIGINAL BNE LOP5 LDA LXSP+1 ;SET POSITION STA PNTR ;TO ORIGINAL VALUE CMP INDX ;IF NOT BEHIND END OF RECORD BCC LOP5 ;GET CHAR FROM DEVICE 3 BCS CLP2 ;(BRA) ELSE RETURN RETURN;