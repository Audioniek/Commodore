;NAME "@1:BASIC4EF4B.INC";**********************************;*                                *;* EXTERNAL LABELS.               *;*                                *;**********************************CTIMR = $008D ;THE JIFFY CLOCKCINV = $0090 ;IRQ RAM VECTORCBINV = $0092 ;BRK RAM VECTORLSTX = $0097 ;LAST SCAN INDEXSHFLAG = $0098 ;SHIFTKEY INDICATORNDX = $009E ;NUMBER OF KEYS IN KEYBOARD BUFFERRVS = $009F ;FLAG FOR REVERSE FIELD PRINTINGINDX = $00A1 ;RECORD LENGTH OF CURRENT SCREEN LINELXSP = $00A3 ;CURSOR ROW/COLUMN, USED IN INPUT AND GETSFDX = $00A6 ;CURRENT SCAN INDEXBLNSW = $00A7 ;FLAG: CURSOR ONBLNCT = $00A8 ;COUNTDOWN TILL NEXT CURSOR BLINKGDBLN = $00A9 ;REAL CHARACTER UNDER CURSORBLNON = $00AA ;CURSOR'S BLINK PHASECRSW = $00AC ;FLAG: INPUT FROM SCREEN OR KEYBOARDDFLTN = $00AF ;CURRENT INPUT DEVICE NUMBERDFLTO = $00B0 ;CURRENT OUTPUT DEVICE NUMBERPNT = $00C4 ;SCREEN LINE ADDRESS, LOPOINT = $00C5 ;SCREEN LINE ADDRESS, HIPNTR = $00C6 ;CURRENT COLUMN POSITION OF CURSORSAL = $00C7 ;POINTER IN SCREEN SCROLLSAH = $00C8 ;POINTER IN SCREEN SCROLL, HIQTSW = $00CD ;FLAG: NONZERO IF IN QUOTE MODEFNLEN = $00D1 ;TEMP. WORKAREA FOR CRTC SETUPLNMX = $00D5 ;LENGTH OF CURRENT SCREEN LINETBLX = $00D8 ;CURRENT LINE NUMBER OF CURSORDATA = $00D9 ;LAST KEY INPUTINSRT = $00DC ;NUMBER OF INSERTS OUTSTANDINGLDTB1 = $00E0 ;SCREEN LINE WRAP AROUND TABLECAS1 = $00F9 ;FLAG: CASSETTE #1 MOTOR ONCAS2 = $00FA ;FLAG: CASSETTE #2 MOTOR ONPI = $00FF ;VALUE FOR PIKEYD = $026F ;KEYBOARD BUFFERDELAY = $03E9 ;DELAY FOR REPEAT KEYKOUNT = $03EA ;REPEAT RATE FOR REPEAT KEYXMAX = $03EB ;MAXIMUM KEYBOARD BUFFER LENGTHRPTFLG = $03EE ;FLAG: REPEAT PRESSEDUDTIM = $FFEA ;UPDATE JIFFY CLOCKPIAL = $E810 ;KEYBOARD PIA: I/O PORT A AND DDRPIAL1 = $E811 ;KEYBOARD PIA: CONTROL REGISTER APIAK = $E812 ;KEYBOARD PIA: I/O PORT B AND DDRPIAS = $E813 ;KEYBOARD PIA: CONTROL REGISTER BIEEI = $E820 ;IEEE PIA: I/O PORT A AND DDRIEEIS = $E821 ;IEEE PIA: CONTROL REGISTER AIEEO = $E822 ;IEEE PIA: I/O PORT B AND DDRIEEOS = $E823 ;IEEE PIA: CONTROL REGISTER BPIA = $E840 ;VIA: I/O PORT BSYNC = $E841 ;VIA: I/O PORT A WITH HANDSHAKEP2DB = $E842 ;VIA: PORT B DATA DIRECTION REGISTERP2DA = $E843 ;VIA: PORT A DATA DIRECTION REGISTERT1L = $E844 ;VIA: TIMER 1 LOT1H = $E845 ;VIA: TIMER 1 HIT1LL = $E846 ;VIA: TIMER 1 LO, LATCHT1LH = $E847 ;VIA: TIMER 1 HI, LATCHT2L = $E848 ;VIA: TIMER 2 LOT2H = $E849 ;VIA: TIMER 2 HISR = $E84A ;VIA: SHIFT REGISTERACR = $E84B ;VIA: AUXILIARY CONTROL REGISTERPCR = $E84C ;VIA: PERIPHERAL CONTROL REGISTERIFR = $E84D ;VIA: INTERRUPT FLAG REGISTERIER = $E84E ;VIA: INTERRUPT ENABLE REGISTERSYNC1 = $E84F ;VIA: PORT A WITHOUT HANDSHAKECR0 = $E880 ;CRTC: ADDRESS REGISTERCR1 = $E881 ;CRTC: REGISTER SELECTED THROUGH CR0 ;