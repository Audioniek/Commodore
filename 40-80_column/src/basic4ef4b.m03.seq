;NAME "@1:BASIC4EF4B.M03";**********************************;*                                *;* PUT SHIFTED CHARACTERS TO      *;* SCREEN.                        *;*                                *;**********************************NXTX AND #$7F ;REMOVE SHIFT BIT CMP #PI-$80 ;IF CODE FOR PI BNE NXTX1 LDA #$5E ;GET REAL CODE FOR PINXTX1 CMP #$20 ;IF PRINTABLE BCC E2E4 JMP NXT33 ;GO FILL SCREENE2E4 CMP #$0D ;IF SHIFT-RETURN BNE UP5 JMP E3BF ;GO DO RETURNUP5 LDX QTSW ;IF QUOTE MODE BNE UP6 ;PRINT AS CONTROL CHARACTER CMP #$14 ;NO QUOTE MODE, IF INSERT BNE UP9 LDY LNMX LDA (PNT),Y ;GET LAST CHAR. OF LINE CMP #$20 ;IF BLANK BNE INS3 CPY PNTR ;AND NOT ON LAST POSITION BNE INS1 ;THEN ENOUGH SPACE ON LINEINS3 CPY #79 ;IF LAST CHAR. NOT BLANK BEQ NCZ2 ;AND LENGTH IS 79, IGNORE JSR NEWLN ;ELSE SCROLLDOWN & INSERT BLANK LINEINS1 LDY LNMX ;GET NEW LENGTHINS2 DEY ;MOVE LDA (PNT),Y ;CHARACTERS INY ;ONE POSITION STA (PNT),Y ;FURTHER DEY ;UNTIL CPY PNTR ;ALL DONE BNE INS2 LDA #$20 ;AND PUT A BLANK STA (PNT),Y ;IN SPACE OPENED UP INC INSRT ;ADAPT INSERT COUNTER BNE JLP2 ;AND EXITUP9 LDX INSRT ;IF INSERTS OUTSTANDING BEQ UP2UP6 ORA #$40 ;CONVERT TO SCREEN CODE JMP NC3 ;AND PRINT AS CONTROL CHAR.UP2 CMP #$11 ;IF CURSOR-UP BNE NXT2 LDA PNTR CMP #40 ;AND CURRENT POSITION >40 BCC UP1 SBC #40 ;MOVE CURSOR UP STA PNTR BCS JLP2 ;AND EXITUP1 LDX TBLX ;GET LINE NUMBER BEQ JLP2 ;IF TOP LINE, EXIT LDA LDTB1-1,X ;IF PREVIOUS LINE 'NOT-EXTENDED' BPL UP3 DEC TBLX ;DECREMENT LINE NUMBER JSR STUPT ;ADAPT POINTER BCC JLP2 ;AND EXITUP3 DEX ;IF PREVIOUS LINE 'EXTENDED DEX ;DECREMENT LINE NUMBER TWICE STX TBLX ;AND STORE IT JSR STUPT ;GET POINTER LDA PNTR ;GET POSITION CLC ADC #40 ;AND SET CURSOR ON SECOND STA PNTR ;PART OF THAT LINE BNE JLP2 ;AND EXITNXT2 CMP #$12 ;IF RVS-OFF BNE NXT6 LDA #$00 STA RVS ;RESET REVERSE FLAG BEQ JLP2 ;AND EXITNXT6 CMP #$1D ;IF CURSOR-LEFT BNE E36C DEY STY PNTR ;DECREMENT POSITION BPL JLP2 ;EXIT, IF STILL ON SAME LINE JSR BKLN ;ELSE DO BACKWARDS OVER BOUNDARY JMP LOOP2 ;AND EXITE36C CMP #$13 ;IF CLR-SCREEN BNE E376 JSR CLSR ;CLEAR THE SCREENJLP2 JMP LOOP2 ;AND EXITE376 CMP #$16 ;IF ERASE FROM START BNE E387 LDA #$20 ;GET BLANK LDY #$00 ;START AT BEGIN OF LINEE37E CPY PNTR ;IF CURRENT POSITION REACHED BCS JLP2 ;EXIT STA (PNT),Y ;STORE BLANK INY BNE E37EE387 CMP #$0E ;IF GRAPHICS BNE E390 JSR E617 ;SET TO GRAPHICS BMI JLP2 ;AND EXITE390 CMP #$07 ;IF SHIFT-BELL BNE E399 JSR E654 ;RING BELL TWICE BEQ JLP2 ;AND EXITE399 CMP #$09 ;IF NOT SHIFT-TAB BNE JLP2 ;IGNORE THE CHARACTER JSR E588 ;TAB, GET TABSTOP EOR $03EF ;ADD OR CLEAR TABSTOPBIT STA $03F0,X ;AND STORE AGAIN JMP LOOP2 ;AND EXIT;**********************************;*                                *;* SET NEXT LINE NUMBER.          *;*                                *;**********************************NXLN SEC ;SET COPY OF LINE NUMBER INVALID LSR LXSP ;BUG: WRONG TYPE OF SHIFT LDX TBLX ;GET LINE NUMBERNXLN2 INX ;INCREMENT IT CPX #25 ;IF AT MAXIMUM LINE NUMBER BNE NXLN1 JSR SCROL ;SCROLL SCREEN UPNXLN1 LDA LDTB1,X ;IF LINE IS 'EXTENDED' BPL NXLN2 ;SCROLL ANOTHER TIME STX TBLX ;STORE LINE NUMBER JMP STUPT ;AND GET POINTER OF CURRENT LINE;**********************************;*                                *;* ACTION FOR RETURN.             *;*                                *;**********************************E3BF JSR NXLN ;SET NEXT LINE NUMBERE3C2 LDA #0 STA PNTR ;SET CURSOR AT BEGINNING OF LINENXTL LDA #0 ;(ENTRY USED BY ESC) STA INSRT ;CANCEL INSERTS OUTSTANDING STA RVS ;RESET REVERSE FLAG STA QTSW ;CANCEL QUOTE MODE JMP LOOP2 ;AND EXIT;**********************************;*                                *;* SCROLL SCREEN UP.              *;*                                *;**********************************SCROL LDX #25 ;SET UP LINE NUMBER STX TBLX ;STORE ITE3D5 LDX #$FFE3D7 INX LDA LDTB2,X ;GET LO-BYTE OF FIRST LINE STA PNT ;STORE IT LDA LDTB1,X ;GET HI-BYTE ALSO ORA #$80 ;SET MSB STA PNT+1 ;AND STORE AS WELL CPX #24 ;IF ALL LINES DONE BCS E404 ;GO FILL BOTTOM LINE WITH SPACES LDY LDTB1+1,X ;IF NEXT LINE 'EXTENDED' BMI SCRL3 AND #$7F ;SET CURRENT LINE TO 'EXTENDED'SCRL3 STA LDTB1,X TYA ;GET HI-BYTE OF NEXT LINE ORA #$80 ;SET MSBSCRL1 STA SAH LDA LDTB2+1,X ;GET LO-BYTE ALSO STA SAL LDY #39 ;MOVE 40 CHARACTERSMLP1 LDA (SAL),Y ;GET CHAR OF NEXT LINE STA (PNT),Y ;MOVE IT TO CURRENT LINE DEY ;UNTIL BPL MLP1 ;WHOLE LINE DONE BMI E3D7 ;THEN DO NEXT LINEE404 STA LDTB1,X ;STORE LAST HI-BYTE LDY #39 LDA #$20 ;GET BLANKMLP2 STA (PNT),Y ;FILL BOTTOM LINE WITH SPACES DEY BPL MLP2 DEC TBLX ;ADAPT LINE NUMBER LDA LDTB1 ;IF FIRST LINE BPL E3D5 ;IS 'EXTENDED', REPEAT LDA PIAK ;GET KEY IMAGE (OF LAST ROW) CMP #$FE ;IF RVS PRESSED BNE MLP42 LDY #$00MLP41 NOP ;WAIT DEX BNE MLP41 ;A DEY BNE MLP41 ;WHILE STY NDX ;CANCEL KEYBOARD BUFFERMLP42 LDX TBLX ;AND GET LINE NUMBER RTS .IFE HZ50 < * = $E42E;**********************************;*                                *;* CLOCK CORRECTION.              *;* ADD AN EXTRA CLOCK TICK IN     *;* EVERY FIVE, BECAUSE SCREEN IS  *;* REFRESHED WITH A 50 HZ RATE    *;* INSTEAD OF THE USUAL 60 HZ.    *;*                                *;**********************************FIFTYH JSR UDTIM ;ADAPT CLOCK INC $03ED ;ADAPT CORRECTION COUNTER LDA $03ED CMP #6 ;IF NOT FIVE TICKS DONE BNE E458 ;DO REST OF INTERRUPT LDA #0 ;IF FIVE TICKS DONE STA $03ED ;RESET CORRECTION COUNT BEQ FIFTYH ;AND DO AN EXTRA TICK>;**********************************;*                                *;* DEFAULT INTERRUPT ROUTINE,     *;* ENTERED 50/60 TIMES PER SECOND *;*                                *;* (POINTED TO BY ROM).           *;*                                *;********************************** * = $E442PULS PHA ;SAVE A TXA PHA ;SAVE X TYA PHA ;AND Y TSX LDA $0104,X ;GET SAVED STATUS REG. AND #$10 ;TEST FOR BRK-INSTRUCTION BEQ PULS1 ;IF BRK JMP (CBINV) ;GO DO BRK-ROUTINEPULS1 JMP (CINV) ;ELSE DO IRQ-ROUTINE .IFE HZ50 <KEY JMP FIFTYH ;IRQ-ENTRY (POINTED TO BY ($90))> .IFN HZ50 <KEY JSR UDTIM ;IRQ-ENTRY (POINTED TO BY ($90))> ;