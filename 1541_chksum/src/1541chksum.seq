; NAME "1541CHKSUM" .OPT NOLIST,ERRORS,SYMBOL; PROGRAM TO SET THE CHECKSUMS OF A 1541 ROM IMAGEOFFSET =$8000 ;COMPENSATE FOR RAM STORAGECCHKSM =$C000-OFFSETCCHSM2 =$C001-OFFSETOLDCCS =$03F8ECHKSM =$FEE6-OFFSETECHSM2 =$FFE5-OFFSETOLDECS =$03F9; BASIC 4.0!POKER =$11 ; INDEXMEMSIZ =$34STROUT =$BB1DSPACE =$D531CLEARC =$B5F0CRLF =$D534WROB =$D722BASOUT =$FFD2 ; LINE OF BASIC TO ALLOW ; USER TO TYPE 'RUN' *= $0401 .BYTE $0D,$04,$0A,$0,$9E ; LINK, LINE#, TOKEN FOR SYS .BYTE '(1039)',0,0,0 ; MACHINE CODE PART CLD ; CLEAR POSSIBLE DECIMAL MODE LDA #$40 ; PROTECT STA MEMSIZ+1 ; LOADED LDA #0 ; ROM IMAGE STA MEMSIZ ; BY JSR CLEARC ; SETTING NEW TOP OF RAM LDA #<TXT1 ; POINT TO LDY #>TXT1 ; ROM IMAGE... JSR STROUT ; PRINT ON SCREEN LDY #0 ; CLEAR VALUE LDA ECHKSM ; GET CURRENT CHECKSUM CMP #$79 ; IF $79 BEQ NEWCS ; USE 2ND LOCATION STA OLDECS ; ELSE SAVE FOR LATER STY ECHKSM ; CLEAR E-ROM CHKSUM CPY ECHKSM ; IF NOT WRITABLE BEQ CONT1 ; HANG FOREVERCHKPRO LDA #<TXT6 ; POINT TO LDY #>TXT6 ; 'CHECKSUM NOT WRITABLE JSR STROUTCHKPR1 BNE CHKPR1 ; HANG FOREVERNEWCS LDA ECHSM2 ; GET ORIGINAL CHECKSUM STA OLDECS ; SAVE FOR LATER STY ECHSM2 ; CLEAR E-ROM CHKSUM CPY ECHSM2 ; IF NOT WRITABLECHKPR2 BNE CHKPRO ; HANG FOREVER ;CONT1 STY POKER ; CLR LO-BYTE OF POINTER TYA ; CLEAR .A SEC ; PREPARE FOR SUBTRACT SBC #>OFFSET ; COMPENSATE FOR RAM STORAGE STA POKER+1 ; (POKER)=$10000-OFFSET JSR GENCHK ; GENERATE CHECKSUM FOR E-ROM LDY ECHKSM ; GET CORRECTION BYTE CPY #$79 ; IF NEW METHOD BEQ NEWCS2 ; DO THAT STA ECHKSM ; ELSE SET IT JMP CONT2 ; AND CONTINUENEWCS2 STA ECHSM2 ; SET IT ;DO C-ROMCONT2 LDY #0 ; CLEAR VALUE LDA ECHKSM ; GET E-CHECKSUM BYTE CMP #$79 ; IF $79 BEQ NEWCS3 ; USE NEW LOCATION LDA CCHKSM ; GET ORIGINAL CHECKSUM STA OLDCCS ; SAVE FOR LATER STY CCHKSM ; ELSE CLEAR C-ROM CHECKSUM CPY CCHKSM ; IF NOT WRITEABLE BNE CHKPRO ; HANG FOREVER BEQ CONT3 ; ELSE CONTINUENEWCS3 LDA CCHSM2 ; GET ORIGINAL CHECKSUM STA OLDCCS ; SAVE FOR LATER STY CCHSM2 ; CLEAR NEW C-ROM CHECKSUM CPY CCHSM2 ; IF NOT WRITABLE BNE CHKPRO ; HANG FOREVER ;DO C-ROMCONT3 STY POKER ; CLEAR LO BYTE ADDRESS JSR GENCHK ; CALCULATE CHECKSUM LDY ECHKSM ; GET E-CHKSUM BYTE CPY #$79 ; IF $79 BEQ NEWCS4 ; DO OTHER LOCATION STA CCHKSM ; STORE IT JMP CONT4 ; AND PROCEEDNEWCS4 STA CCHSM2 ; SET CHECKSUM ; DISPLAY RESULTSCONT4 LDA #<TXT2 ; POINT TO LDY #>TXT2 ; 'C:CHKSUM= JSR STROUT ; PRINT ON SCREEN LDY ECHKSM ; IF NEW METHOD CPY #$79 BEQ NEWCS5 ; DO THAT LDA CCHKSM ; ELSE GET CHECKSUM JMP CONT5NEWCS5 LDA CCHSM2 ; GET NEW CHKSUMCONT5 PHA ; SAVE CALCULATED CHECKSUM JSR WROB ; PRINT ON SCREEN CPY #$79 BNE NEWCS6 LDA #$'*'       ; SIGNAL NEW METHOD JSR BASOUTNEWCS6 PLA ; GET CHECKSUM BACK CMP OLDCCS ; IF CHANGED BNE PRECS ; SHOW E-CHECKSUM LDA #<TXT5 ; ELSE LDY #>TXT5 ; SHOW JSR STROUT ; (OK)PRECS LDA #<TXT3 ; POINT TO LDY #>TXT3 ; 'E-CHKSUM= JSR STROUT ; PRINT ON SCREEN LDY ECHKSM ; GET CHECKSUM CPY #$79 ; IF NEW METHOD BEQ NEWCS7 ; DO THAT LDA ECHKSM ; ELSE GET CHECKSUM JMP CONT6 ; AND SHOWNEWCS7 LDA ECHSM2 ; GET NEW CHECKSUMCONT6 PHA ; SAVE CALCULATED CHECKSUM JSR WROB ; PRINT ON SCREEN LDY ECHKSM ; GET CHECKSUM CPY #$79 ; IF NEW METHOD BNE NEWCS8 ; LDA #$'*'       ; SIGNAL IT JSR BASOUTNEWCS8 PLA ; GET CALCULATED CHECKSUM BACK CMP OLDECS ; IF CHANGED BNE NEWCS9 ; END PROGRAM LDA #<TXT5 ; ELSE LDY #>TXT5 ; SHOW JSR STROUT ; (OK)NEWCS9 LDA #<TXT4 ; POINT TO LDY #>TXT4 ; 'CHECKSUMS SET.. JSR STROUT ; PRINT ON SCREEN BRK ; AND CALL MLM TO SAVE THE RESULT; GENCHK LDX #32 ; DO 32 PAGES LDA #0 ; CLEAR .A (RESULT) TAY ; AND .Y (INDEX) CLC ; PREPARE FOR ADDCHK0 DEC POKER+1 ; DO IT BACKWARDSCHK1 ADC (POKER),Y ; ADD ROM BYTE TO .A INY ; POINT TO NEXT BYTE BNE CHK1 ; LOOP UNTIL PAGE DONE;  DEX ; COUNT PAGES BNE CHK0 ; NOT ALL PAGES DONE, LOOP;  ADC #0 ; ADD FINAL CARRY STA POKER ; SAVE RESULT LDA POKER+1 ; GET HI BYTE ADDRESS CLC ; PREPARE FOR ADD ADC #>OFFSET ; CALCULATE DESIRED RESULT SEC ; PREPARE FOR SUBTRACT SBC POKER ; .A=CHECKSUM BYTE RTS ; AND EXIT;TXT1 .BYTE $0D,'1541 ROM CHECKSUMMER V1.3',$0D .BYTE $0D,'ROM IMAGE MUST BE AT $4000-$7FFF.',$0D,0TXT2 .BYTE $0D,'C-CHKSUM = $',0TXT3 .BYTE $0D,'E-CHKSUM = $',0TXT4 .BYTE $0D,$0D,'CHECKSUMS SET, NOW SAVE IMAGE.',$0D .BYTE 0TXT5 .BYTE ' (OK)',0TXT6 .BYTE 'CHECKSUM BYTE NOT WRITABLE.',$0D,0 .END