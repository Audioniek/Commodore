;NAME "@1:BASIC4EG8.M02"; * = $E116 ;FIXED ADDRESS IN F-ROM;**********************************;*                                *;* GET CHARACTER FROM DEVICE 0 OR *;* DEVICE 3.                      *;*                                *;**********************************LOOP5 TYA PHA ;SAVE Y TXA PHA ;SAVE X JMP (VINP) ;AND GET INPUT (DEFAULT LOP55)LOP55 LDA CRSW ;IF INPUT FROM KEYBOARD BEQ LOOP3 ;GO DO KEYBOARD UNTIL RETURN;**********************************;*                                *;* GET CHARACTER FROM CURRENT     *;* SCREEN LINE.                   *;*                                *;**********************************LOP5 LDY PNTR ;GET POSITION LDA (PNT),Y ;GET SCREEN CHARACTER STA DATA ;SAVE ITLOP51 AND #$3F ;REMOVE BITS 6 AND 7 ASL DATA BIT DATA ;IF ORIGINAL BIT 6 SET BPL LOP54 ORA #$80 ;SET BIT 7 (SHIFT BIT)LOP54 BCC LOP52 ;IF ORIGINAL BIT 7 SET LDX QTSW ;AND IF IN QUOTE MODE BNE LOP53 ;DON'T CHANGE BIT 6LOP52 BVS LOP53 ;ELSE IF BIT 5 SET IN ORIGINAL ORA #$40 ;SET BIT 6LOP53 INC PNTR ;ADAPT POSITION JSR QTSWC ;ADAPT QUOTE FLAG CPY INDX ;IF MAX POSITION REACHED BNE CLP1CLP2 LDA #$00 STA CRSW ;FLAG INPUT FROM KEYBOARD LDA #$0D ;AND ECHO RETURN LDX DFLTN ;IF INPUT DEVICE CPX #3 ;IS SCREEN BEQ CLP2A ;GO ECHO ON SCREEN LDX DFLTO ;ELSE IF OUTPUT DEVICE CPX #3 ;IS SCREEN BEQ CLP21 ;STORE RETURN IN LAST INPUTCLP2A JSR PRT ;ECHO ON SCREENCLP21 LDA #$0D ;AND STORE A RETURNCLP1 STA DATA ;IN LAST KEY INPUT PLA TAX ;RESTORE X PLA TAY ;RESTORE Y LDA DATA ;GET CHARACTER AGAIN CMP #$DE ;IF CODE FOR PI BNE CLP7 LDA #PI ;GET REAL CODE FOR PICLP7 RTS;**********************************;*                                *;* TOGGLE QUOTE FLAG IF " FOUND.  *;*                                *;**********************************QTSWC CMP #'"' ;IF CHARACTER IS " BNE QTSWL LDA QTSW ;GET QUOTE FLAG EOR #$01 ;INVERT BIT 0 STA QTSW LDA #'"' ;AND RESTORE CHARACTERQTSWL RTS;**********************************;*                                *;* FILL SCREEN AT CURRENT         *;* POSITION.                      *;*                                *;**********************************NXT33 ORA #$40 ;MAP SHIFTED CHARACTERSNXT3 LDX $9F ;IF REVERSE SWITCH ON BEQ NVSNC3 ORA #$80 ;SET SCREENCODE FOR REVERSENVS LDX INSRT ;IF IN INSERT MODE BEQ NVSL DEC INSRT ;DECREASE INSERT COUNTNVSL JSR DSPP ;PUT CHAR AT CURRENT POSITION IN RAMJSTS INC PNTR ;ADVANCE CHARACTER POSITION LDY SCRT ;IF BEYOND MAXIMUM LENGTH CPY PNTR BCS LOOP2 LDX TBLX ;GET LINE NUMBER IN XJSTS1 JSR NXLN ;SCROLL WINDOW IF NECESSARY LDY SCLF ;GET LEFT MARGIN STY PNTR ;PUT CURSOR THERE;**********************************;*                                *;* EXIT FROM OUTPUT TO SCREEN.    *;*                                *;**********************************LOOP2 LDA #0 STA FHOME ;CLEAR HOME COUNTERLOPII PLA TAY ;RESTORE Y LDA INSRT ;IF INSERTS OUTSTANDING BEQ LOP2 LSR QTSW ;CANCEL QUOTE MODELOP2 PLA TAX ;RESTORE X PLA ;AND A CLI ;ALLOW INTERRUPTS AGAIN RTS;**********************************;*                                *;* BACKWARD OVER LINE BOUNDARY.   *;*                                *;**********************************BKLN LDY SCRT ;GET RIGHT MARGIN LDX SCTOP ;AND TOP LINE NUMBER OF WINDOW CPX TBLX ;IF ON TOP LINE BCC BKLN1 ;SET CURSOR HOME IN WINDOW LDY SCLF ;GET LEFT MARGIN STY PNTR ;AND PUT CURSOR HOME PLA PLA ;REMOVE RETURN ADDRESS BNE LOOP2 ;AND EXITBKLN1 DEC TBLX ;MOVE CURSOR TO PREVIOUS LINE STY PNTR ;AND PUT IT ON RIGHT MARGIN JMP STUPT ;AND GET POINTER OF THAT LINE;**********************************;*                                *;* ERASE LINE UNTIL RIGHT MARGIN. *;*                                *;**********************************CLRLN LDA #$20 ;GET BLANKCLR10 INY STA (PNT),Y ;STORE ON LINE CPY SCRT ;UNTIL RIGHT MARGIN REACHED BCC CLR10 RTS;**********************************;*                                *;* SET CURSOR ON LEFT MARGIN.     *;*                                *;**********************************PATCH1 LDY SCLF ;GET LEFT MARGIN STY PNTR ;PUT CURSOR THERE LDY #0 ;PREPARE FOR CANCEL QUOTE MODE RTS;**********************************;*                                *;* SET WINDOW TO FULL SCREEN.     *;*                                *;**********************************SRESET LDA #0 ;GET TOP LINE # TAX ;AND LEFT MARGIN JSR TOPLF ;SET THEM LDA #24 ;GET BOTTOM LINE # LDX #79 ;AND RIGHT MARGIN;**********************************;*                                *;* SET BOTTOM RIGHT OF WINDOW.    *;*                                *;**********************************BOTRT STA SCBOT ;STORE BOTTOM LINE # STX SCRT ;AND RIGHT MARGIN RTS;**********************************;*                                *;* SET TOP LEFT OF WINDOW.        *;*                                *;**********************************TOPLF STA SCTOP ;SET TOP LINE # STX SCLF ;AND LEFT MARGIN RTS;