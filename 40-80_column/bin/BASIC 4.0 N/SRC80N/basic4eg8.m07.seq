;NAME "@1:BASIC4EG8.M07";**********************************;*                                *;* KEYBOARD TABLE, FOR 80 KEYS.   *;*                                *;**********************************CHAR .BYT '=.', $10, $03, '<', ' [', $12 ;SCAN LINE NINE .BYT '-0', $00, '>', $FF, ']@', $00 ;SCAN LINE EIGHT .BYT '+2', $FF, '?,NVX' ;SCAN LINE SEVEN .BYT '31', $0D, ';MBCZ' ;SCAN LINE SIX .BYT '*5', $FF, ':KHFS' ;SCAN LINE FIVE .BYT '64', $FF, 'LJGDA' ;SCAN LINE FOUR .BYT '/8', $FF, 'PIYRW' ;SCAN LINE THREE .BYT '97', $5E, 'OUTEQ' ;SCAN LINE TWO .BYT $14, $11, $09, ')\', $27, '$"' ;SCAN LINE ONE .BYT $1D, $13, $5F, '(&%#!' ;SCAN LINE ZERO;**********************************;*                                *;* MESSAGE: D SHIFT-L "* RETURN   *;* RUN RETURN                     *;*                                *;**********************************RUNTB .BYT 'D', $CC, '"*', $0D, 'RUN', $0D;**********************************;*                                *;* TWO TABLES OF 18 CONSTANTS     *;* EACH FOR THE CRT-CONTROLLER.   *;* THE FIRST TABLE IS FOR TEXT    *;* MODE, THE SECOND FOR GRAPHICS  *;* MODE.                          *;*                                *;********************************** .IFE HZ50 < ; TEXT MODE TABLE, 50 HZTEXT .BYT 49 ;HORIZONTAL TOTAL .BYT 40 ;HORIZONTAL DISPLAYED .BYT 41 ;HORIZONTAL SYNC POSITION .BYT 15 ;HORIZONTAL SYNC WIDTH .BYT 39 ;VERTICAL TOTAL .BYT 0 ;VERTICAL TOTAL ADJUST .BYT 25 ;VERTICAL DISPLAYED .BYT 32 ;VERTICAL SYNC POSITION .BYT 0 ;INTERLACE MODE (OFF) .BYT 9 ;MAXIMUM SCAN LINE ADDRESS .BYT 0 ;CURSOR START .BYT 0 ;CURSOR END .BYT %00010000 ;START ADDRESS (HI) (INVERTS VIDEO) .BYT 0 ;START ADDRESS (LO) .BYT 0 ;CURSOR (HI) .BYT 0 ;CURSOR (LO) .BYT 0 ;LIGHT PEN (HI) .BYT 0 ;LIGHT PEN (LO) ; GRAPHICS MODE TABLE, 50 HZGRAF .BYT 49 ;HORIZONTAL TOTAL .BYT 40 ;HORIZONTAL DISPLAYED .BYT 41 ;HORIZONTAL SYNC POSITION .BYT 15 ;HORIZONTAL SYNC WIDTH .BYT 49 ;VERTICAL TOTAL .BYT 0 ;VERTICAL TOTAL ADJUST .BYT 25 ;VERTICAL DISPLAYED .BYT 37 ;VERTICAL SYNC POSITION .BYT 0 ;INTERLACE MODE (OFF) .BYT 7 ;MAXIMUM SCAN LINE ADDRESS .BYT 0 ;CURSOR START .BYT 0 ;CURSOR END .BYT %00010000 ;START ADDRESS (HI) (INVERTS VIDEO) .BYT 0 ;START ADDRESS (LO) .BYT 0 ;CURSOR (HI) .BYT 0 ;CURSOR (LO) .BYT 0 ;LIGHT PEN (HI) .BYT 0 ;LIGHT PEN (LO)> ;END OF 50 HZ TABLES .IFN HZ50 < ; TEXT MODE TABLE, 60 HZTEXT .BYT 49 ;HORIZONTAL TOTAL .BYT 40 ;HORIZONTAL DISPLAYED .BYT 41 ;HORIZONTAL SYNC POSITION .BYT 15 ;HORIZONTAL SYNC WIDTH .BYT 32 ;VERTICAL TOTAL .BYT 3 ;VERTICAL TOTAL ADJUST .BYT 25 ;VERTICAL DISPLAYED .BYT 29 ;VERTICAL SYNC POSITION .BYT 0 ;INTERLACE MODE (OFF) .BYT 9 ;MAXIMUM SCAN LINE ADDRESS .BYT 0 ;CURSOR START .BYT 0 ;CURSOR END .BYT %00010000 ;START ADDRESS (HI) (INVERTS VIDEO) .BYT 0 ;START ADDRESS (LO) .BYT 0 ;CURSOR (HI) .BYT 0 ;CURSOR (LO) .BYT 0 ;LIGHT PEN (HI) .BYT 0 ;LIGHT PEN (LO) ; GRAPHICS MODE TABLE, 60 HZGRAF .BYT 49 ;HORIZONTAL TOTAL .BYT 40 ;HORIZONTAL DISPLAYED .BYT 41 ;HORIZONTAL SYNC POSITION .BYT 15 ;HORIZONTAL SYNC WIDTH .BYT 40 ;VERTICAL TOTAL .BYT 5 ;VERTICAL TOTAL ADJUST .BYT 25 ;VERTICAL DISPLAYED .BYT 33 ;VERTICAL SYNC POSITION .BYT 0 ;INTERLACE MODE (OFF) .BYT 7 ;MAXIMUM SCAN LINE ADDRESS .BYT 0 ;CURSOR START .BYT 0 ;CURSOR END .BYT %00010000 ;START ADDRESS (HI) (INVERTS VIDEO) .BYT 0 ;START ADDRESS (LO) .BYT 0 ;CURSOR (HI) .BYT 0 ;CURSOR (LO) .BYT 0 ;LIGHT PEN (HI) .BYT 0 ;LIGHT PEN (LO)> ;END OF 60 HZ TABLES;**********************************;*                                *;* CONSTANTS FOR BELL.            *;*                                *;**********************************TONES .BYT $0E, $1E, $3E, $7E, $3E, $1E, $0E;**********************************;*                                *;* TABLE OF LO-BYTES OF SCREEN    *;* LINE ADDRESSES.                *;*                                *;**********************************LDTB2 .BYT 0, 80, 160, 240, 64, 144, 224 .BYT 48, 128, 208, 32, 112, 192 .BYT 16, 96, 176, 0, 80, 160, 240 .BYT 64, 144, 224, 48, 128;**********************************;*                                *;* TABLE OF HI-BYTES OF SCREEN    *;* LINE ADDRESSES.                *;*                                *;**********************************LDTB1 .BYT $80, $80, $80, $80 .BYT $81, $81, $81, $82, $82, $82 .BYT $83, $83, $83, $84, $84, $84 .BYT $85, $85, $85, $85 .BYT $86, $86, $86, $87, $87;**********************************;*                                *;* CHECKSUM BYTE.                 *;*                                *;**********************************CKSUME .BYT 0;**********************************;*                                *;* COPYRIGHT STATEMENT.           *;*                                *;********************************** .BYT 'ALL ALTERATIONS:        ' .BYT '(C) 1983 NDV FIRMWARE           ';**********************************;*                                *;* THE REST OF ROM IS NOT USED,   *;* AND MAY CONTAIN ANYTHING.      *;*                                *;**********************************