;NAME "@1:BASIC4EG8.M04";**********************************;*                                *;* ACTION FOR CURSOR DOWN;        *;* SCROLL WINDOW UP IF AT BOTTOM. *;*                                *;**********************************NXLN LSR LXSP ;SET COPY OF LINE # INVALID LDX TBLX ;GET LINE # CPX SCBOT ;IF AT BOTTOM OF WINDOW BCC NXLN1 JSR SCRUP ;SCROLL WINDOW UP JMP STUPT ;AND GET POINTER TO LINENXLN1 INC TBLX ;ELSE ADAPT LINE # JMP STUPT ;AND GET POINTER;**********************************;*                                *;* PROCESS RETURN.                *;*                                *;**********************************NXT1 LDY SCLF ;GET LEFT MARGIN STY PNTR ;PUT CURSOR THERE JSR NXLN ;PERFORM CURSOR DOWNNXTL LDA #0 STA INSRT ;CANCEL INSERTS OUTSTANDING STA RVS ;CANCEL REVERSE FIELD STA QTSW ;CANCEL QUOTE MODE JMP LOOP2 ;AND EXIT;**********************************;*                                *;* SCROLL WINDOW DOWN.            *;*                                *;**********************************SCRDWN LDX SCBOT ;GET BOTTOM LINE # INXNXTL1 DEX JSR STUPR ;GET POINTER AND LEFT MARGIN CPX SCTOP ;IF TOP LINE OF WINDOW REACHED BEQ MLP4 ;CHECK FOR PAUSED SCROLL LDA LDTB2-1,X STA SAL ;GET LO-BYTE OF PREVIOUS LINE LDA LDTB1-1,X ;GE HI-BYTE ALSO STA SAH ;STORE THE POINTERNELL INY LDA (SAL),Y ;GET A CHARACTER OF PREV. LINE STA (PNT),Y ;MOVE TO CURRENT LINE CPY SCRT ;UNTIL RIGHT MARGIN REACHED BCC NELL BCS NXTL1 ;AND DO PREVIOUS LINE;**********************************;*                                *;* SCROLL WINDOW UP.              *;*                                *;**********************************SCRUP LDX SCTOP ;GET TOP LINE # DEXSCRL5 INX JSR STUPR ;GET POINTER AND LEFT MARGIN CPX SCBOT ;IF BOTTOM REACHED BCS MLP4 ;CHECK FOR PAUSED SCROLL LDA LDTB2+1,X ;GET POINTER TO NEXT LINE STA SAL ;STORE LO-BYTE LDA LDTB1+1,X ;DO HI-BYTE ALSO STA SAHMLP1 INY ;DO NEXT CHARACTER LDA (SAL),Y ;MOVE FROM NEXT LINE STA (PNT),Y ;TO CURRENT LINE CPY SCRT ;UNTIL RIGHT MARGIN REACHED BCC MLP1 BCS SCRL5 ;THEN DO NEXT LINE;**********************************;*                                *;* INSERT BLANK LINE AND PAUSE    *;* SCROLL IF APPROPRIATE KEY IS   *;* PRESSED.                       *;*                                *;**********************************MLP4 JSR CLRLN ;INSERT BLANK LINE LDY #0 LDA PIAK ;GET KEY IMAGE CMP #$FB ;IF SPACE PRESSED BNE CKRVSMLP41 NOP ;WAIT DEX ;A BNE MLP41 ;WHILE DEY ;WITH A BNE MLP41 ;DOUBLE LOOP BEQ MLP42 ;(BRA) THEN CANCEL BUFFER AND EXITCKRVS CMP #$FE ;IF NOT RVS PRESSED BNE HLTRTS ;EXITCKSPC LDA PIAK ;ELSE GET KEY IMAGE CMP #$FB BNE CKSPC ;IF NO SPACE, WAITMLP42 STY KBFPTR ;IF SPACE, CANCEL BUFFERHLTRTS RTS ;AND EXIT; .IFE HZ50 < * = $E431;**********************************;*                                *;* DO CLOCK TICKS;                *;* ADD AN EXTRA TICK IN EVERY     *;* FIVE (BECAUSE OF 50 HZ SCREEN  *;* REFRESH INSTEAD OF THE USUAL   *;* 60 HZ).                        *;*                                *;**********************************FIFTYH JSR UDTIM ;DO CLOCK TICK INC FIVCNT ;INCREMENT TICK COUNTER LDA FIVCNT ;IF 5 TICKS DONE CMP #6 BNE SERVCE ;IF NOT FIVE, DO KEYBOARD LDA #0 STA FIVCNT ;CLEAR COUNTER BEQ FIFTYH ;(BRA) AND DO EXTRA TICK> ;END OF 50 HZ CODE; * = $E442 ;FIXED ADDRESS IN F-ROM;**********************************;*                                *;* INTERRUPT ROUTINE;             *;* ENTERED 50/60 TIMES PER SECOND *;*                                *;* (POINTED TO BY ROM).           *;*                                *;**********************************PULS PHA ;SAVE A TXA PHA ;SAVE X TYA PHA ;SAVE Y TSX LDA $0104,X ;GET SAVED STATUSREGISTER AND #$10 ;FILTER BRK-BIT OUT BEQ PULS1 ;IF BRK JMP (CBINV) ;GO DO BRK ROUTINEPULS1 JMP (CINV) ;ELSE DO IRQ ROUTINE (DEFAULT KEY);**********************************;*                                *;* DEFAULT INTERRUPT ROUTINE.     *;*                                *;* (POINTED TO BY ($90)).         *;*                                *;********************************** .IFE HZ50 <KEY JMP FIFTYH ;DO CLOCK TICK(S)> ;END OF 50 HZ CODE .IFN HZ50 <KEY JSR UDTIM ;DO CLOCK TICK> ;END OF 60 HZ CODE;**********************************;*                                *;* REST OF INTERRUPT ROUTINE;     *;* DO CURSOR BLINK.               *;*                                *;**********************************SERVCE LDA BLNSW ;IF CURSOR INVISIBLE BNE KEY4 ;SKIP BLINK HANDLING DEC BLNCT ;DECREMENT COUNTDOWN BNE KEY4 ;IF COUNTDOWN ZERO LDA #20 ;SET NEW COUNTDOWN NOP ;CHECK FOR NOP ;FOR REPEAT NOP ;PRESSED WAS HERE NOP NOP NOPKEY1 STA BLNCT LDY PNTR ;GET COLUMN POSITION LSR BLNON ;DETERMINE BLINK PHASE ;IF ZERO LDA (PNT),Y ;GET CHARACTER AT CURRENT POSITION BCS KEY5 ;IF IN PHASE ZERO INC BLNON ;SET BLINK PHASE ONE STA GDBLN ;AND STORE TRUE CHARACTERKEY5 EOR #$80 ;REVERSE SCREEN CHARACTER STA (PNT),Y ;AND PUT TO SCREEN;**********************************;*                                *;* CASSETTE MOTOR CONTROL.        *;*                                *;**********************************KEY4 LDY #$00 LDA PIAL AND #$F0 ;SET ZERO IN STA PIAL ;KEYBOARD SCAN LINE NUMBER LDA PIAL ;GET CASSETTE SENSE LINES ASL A ASL A ASL A BPL KEY3 ;IF NO KEY DOWN ON CASSETTE 1 STY CAS1 ;FLAG CASSETTE 1 OFF LDA PIAS ORA #$08 ;AND SWITCH MOTOR OFF BNE KL24 ;AND TEST CASS#2KEY3 LDA CAS1 ;KEY DOWN,IF #1 FLAG ON BNE KL2 ;TEST CASS#2 LDA PIAS ;ELSE AND #$F7 ;START CASS#1 MOTORKL24 STA PIASKL2 BCC KL23 ;IF NO KEY DOWN ON CASS.#2 STY CAS2 ;FLAG CASS.#2 OFF LDA PIA ORA #$10 ;AND SWITCH CASS#2 MOTOR OFF BNE KL25KL23 LDA CAS2 ;KEY DOWN,IF #2 FLAG ON BNE KL22 ;FINISH CASSETTE CONTROL LDA PIA ;ELSE AND #$EF ;SWITCH #2 MOTOR ONKL25 STA PIAKL22 JSR KEYSCN ;HANDLE KEYBOARD JMP PREND ;AND RETURN FROM INTERRUPT;