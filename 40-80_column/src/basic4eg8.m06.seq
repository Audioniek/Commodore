;NAME "@1:BASIC4EG8.M06";**********************************;*                                *;* DO REST OF UNSHIFTED           *;* CHARACTERS.                    *;*                                *;**********************************SCTUP CMP #$19 ;IF SCROLL UP BNE ACTION JSR SCRUP ;SCROLL WINDOW UP JMP SCTD10 ;GET POINTER TO LINE AND EXITACTION CMP #$0F ;IF SET TOP BNE TEXX LDA TBLX ;GET CURRENT LINE# STA SCTOP ;STORE IN TOP LINE# LDA PNTR ;GET CURRENT COLUMN# STA SCLF ;STORE IN LEFT MARGINJPL8 JMP LOOP2 ;AND EXITTEXX CMP #$0E ;IF TEXT BNE PBELL JSR TXCRT ;SET CRT CONTROLLER TO TEXT BMI JPL8 ;AND EXITPBELL CMP #$07 ;IF NOT BELL BNE JPL8 ;EXIT (IGNORE CHARACTER) JSR BELL ;IF BELL, RING IT BEQ JPL8 ;AND EXIT;**********************************;*                                *;* DO REST OF SHIFTED             *;* CHARACTERS.                    *;*                                *;**********************************ILINE CMP #$15 ;IF INSERT LINE BNE SCTDWN LDA SCTOP ;GET TOP LINE# PHA ;SAVE IT LDA TBLX ;GET CURRENT LINE# STA SCTOP ;PUT IN TOP LINE# JSR SCRDWN ;SCROLL 'WINDOW' DOWN AND INSERT LINEILN20 PLA STA SCTOP ;RESTORE ORIGINAL TOP LINE# JSR STU10 ;SET CURSOR AT START AND GET PNTR BNE JPL9 ;AND EXITSCTDWN CMP #$19 ;IF SCROLL DOWN BNE BOTSET JSR SCRDWN ;SCROLL WINDOW DOWNSCTD10 JSR STUPT ;GET POINTER TO LINE BNE JPL9 ;AND EXITBOTSET CMP #$0F ;IF SET BOTTOM BNE GRAPH LDA TBLX ;GET CURRENT LINE# STA SCBOT ;STORE IN BOTTOM LINE# LDA PNTR ;GET CURRENT COLUMN# STA SCRT ;STORE IN RIGHT MARGINJPL9 JMP LOOP2 ;AND EXITGRAPH CMP #$0E ;IF NOT GRAPHICS BNE PBELL ;CHECK FOR BELL JSR GRCRT ;ELSE SET TO GRAPHICS BMI JPL9 ;AND EXIT; * = $E600 ;FIXED ADDRESS IN F-ROM;**********************************;*                                *;* EXIT FROM INTERRUPT.           *;*                                *;**********************************PREND PLA TAY ;RESTORE Y PLA TAX ;AND X PLA ;AND A RTI ;AND RETURN FROM INTERRUPT;**********************************;*                                *;* STORE THE CHARACTER IN A       *;* ON SCREEN.                     *;*                                *;**********************************DSPP LDY PNTR ;GET CURSOR POSITION ON LINE STA (PNT),Y ;STORE THE CHARACTER LDA #1 ;SET UP NEW COUNTDOWN STA BLNCT ;FOR CURSOR FLASH RTS ;THEN EXIT;**********************************;*                                *;* RESET; INITIALIZE I/O.         *;*                                *;**********************************EXTRA0 LDA #$7F STA IER ;DISABLE ALL VIA INTERRUPTS LDX #CAS2-TIME ;GET BYTE COUNT LDA #$00 ;CLEARPX1 STA TIME,X ;AREA $8D TO $FA DEX BPL PX1 LDX #USRCMD-TAB ;GET BYTE COUNTCLRALL STA TAB,X ;CLEAR TAB-STOP TABLE DEX BPL CLRALL LDA #<KEY ;SET STA CINV ;IRQ RAM VECTOR LDA #>KEY ;TO STA CINV+1 ;KEYBOARD/CASSETTE ROUTINE LDA #3 ;SET DEFAULT OUTPUT DEVICE STA DFLTO ;TO SCREEN LDA #10 ;GET MAXIMUM STA KBFLIM ;KEYBOARD BUFFER LENGTH LDA #$0F ;KEYBOARD PIA, A SECTION: STA PIAL ;BITS 0-3 OUTPUT, REST INPUT ASL A STA PIA ;VIA: CASSETTE#2 MOTOR OFF ;CASSETTE #1 AND #2 WRITE = 1 ;IEEE ATN=FALSE  NRFD=FALSE STA P2DB ;BITS 7-5,0 OUTPUT, 4-1 INPUT STX IEEO ;IEEE PIA, B SECTION: ALL BITS OUTPUT STX T1H ;VIAT1H: MAXIMUM TIMEOUT LDA #$3D ;KEYBOARD PIA: CASSETTE#1 MOTOR OFF STA PIAS ;IRQ ON NEG EDGE ON CB1 ;(END OF SCREEN REFRESH) BIT PIAK ;CLEAR KEYBOARD PIA INTERRUPT FLAGS LDA #$3C ;IEEE PIA: NDAC=FALSE, CA1 NEG. EDGE STA IEEIS ;NO INTERRUPTS STA IEEOS ;IEEE PIA: DAV=FALSE, CB1 NEG. EDGE ;NO INTERRUPTS STA PIAL1 ;KEYBOARD PIA: CA2=1,CA1 NEG. EDGE ;NO INTERRUPTS STX IEEO ;PIA2B:ALL IEEE DATA LINE FALSE LDA #$0C ;VIA: CA2=0 (GRAPHICS), CA1 NEG. EDGE STA PCR ;NO INTERRUPTS, CB2 INPUT, NEG. EDGE STA BLNCT ;SET BLINK COUNT FOR CURSOR STA BLNSW ;SET CURSOR VISIBLE STA RPTFLG ;ENABLE REPEAT KEY STA RPTCNT ;AND SET DELAY FOR REPEAT JSR SRESET ;SET WINDOW TO FULL SCREEN LDA #<LOP55 LDX #>LOP55 STA VINP ;SET VECTOR FOR STX VINP+1 ;INPUT FROM SCREEN LDA #<PRT55 LDX #>PRT55 STA VOUT ;SET VECTOR FOR STX VOUT+1 ;OUTPUT TO SCREEN LDA #$10 ;SET UP STA FBELL ;BELL TIMING JSR BELL2 BEQ BELL2 ;AND RING BELL 4 TIMES NOP NOP NOP NOP NOP NOP;**********************************;*                                *;* RING BELL IF RIGHT MARGIN      *;* PASSED.                        *;*                                *;**********************************PATCH2 JSR PRT ;MOVE CHARACTER TO SCREEN TAX ;SAVE IT IN X LDA SCRT ;GET RIGHT MARGIN SEC SBC PNTR ;SUBTRACT CURRENT POSITION CMP #5 ;IF 5 FROM MARGIN BNE BEL30 TXA ;GET CHARACTER AGAIN CMP #$1D ;IF CURSOR-RIGHT BEQ BELL2 ;RING BELL TWICE AND #$7F ;REMOVE SHIFT-BIT CMP #$20 ;IF NOT PRINTABLE BCC BEL30 ;EXIT, ELSE RING BELL TWICE;**********************************;*                                *;* RING BELL TWICE.               *;*                                *;**********************************BELL2 JSR BELL ;RING BELL ONCE;**********************************;*                                *;* RING BELL ONCE.                *;*                                *;**********************************BELL LDY FBELL ;GET BELL TIMING BEQ BEL30 ;IF ZERO, DON'T RING BELL LDA #$10 ;SET CB2 TO FREE RUN STA ACR LDA #$0F ;AND TO LOWEST FREQUENCY STA SR LDX #7 ;7 TONES TO PLAYBEL10 LDA TONES-1,X ;GET TONE CONSTANT STA T2L ;PUT TO VIA LDA FBELL ;GET TIMINGBEL20 DEY BNE BEL20 ;WAIT, INNER LOOP SEC SBC #1 BNE BEL20 ;WAIT, OUTER LOOP DEX BNE BEL10 ;AND DO NEXT TONE STX SR ;THEN SILENCE THE VIA STX ACR ;AND ENABLE CASSETTE OPERATIONSBEL30 RTS ;THEN EXIT;