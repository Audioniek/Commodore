;NAME "@1:BASIC4EF4B.M02";**********************************;*                                *;* TOGGLE QUOTE FLAG IF " FOUND.  *;*                                *;**********************************QTSWC CMP #'"' ;IF CHARACTER IS " BNE QTSWL LDA QTSW ;GET QUOTE FLAG EOR #$01 ;INVERT BIT 0 STA QTSW LDA #'"' ;AND RESTORE CHARACTERQTSWL RTS;**********************************;*                                *;* FILL SCREEN AT CURRENT         *;* POSITION.                      *;*                                *;**********************************NXT33 ORA #$40 ;MAP SHIFTED CHARACTERSNXT3 LDX RVS ;IF REVERSE SWITCH ON BEQ NVSNC3 ORA #$80 ;SET SCREENCODE FOR REVERSENVS LDX INSRT ;IF IN INSERT MODE BEQ NVSL DEC INSRT ;DECREASE INSERT COUNTNVSL JSR DSPP ;PUT CHAR AT CURRENT POSITION IN RAMJSTS INC PNTR ;ADVANCE CHARACTER POSITION LDY LNMX ;IF BEYOND MAXIMUM LENGTH CPY PNTR BCS LOOP2 LDX TBLX ;GET LINE NUMBER IN X CPY #79 ;AND AT POSITION 79 BNE JSTS1 JSR JSTSX ;SET CURRENT LINE TO EXTENDED JSR NXLN ;GO TO START OF NEXT LINE LDA #0 ;AND SET CURSOR AT START STA PNTR ;OF THAT LINE BEQ LOOP2JSTS1 CPX #24 ;IF BEYOND LENGTH, BUT <79 BNE JTS2 ;AND ON LAST LINE JSR SCRL ;SCROLL SCREEN UP AND LEAVE CURSOR ON SAME LINE;**********************************;*                                *;* EXIT FROM OUTPUT TO SCREEN.    *;*                                *;**********************************LOOP2 PLA TAY ;RESTORE Y LDA INSRT ;IF IN INSERT MODE BEQ LOP2 LSR QTSW ;SET QUOTE MODE OFFLOP2 PLA TAX ;RESTORE X PLA ;AND A CLI ;ALLOW INTERRUPTS AGAIN RTS;**********************************;*                                *;* SET NEXT LINE TO NOT-EXTENDED. *;*                                *;**********************************JSTSX CPX #23 ;IF LINE NUMBER <=23 BCS JSXB LDA LDTB1+2,X ;SET NEXT LINE ORA #$80 ;TO 'NOT-EXTENDED' STA LDTB1+2,XJSXB RTS;**********************************;*                                *;* INSERT BLANK LINE IF BEYOND    *;* CURRENT LENGTH, BUT NOT AT END *;* OF LINE.                       *;*                                *;**********************************JTS2 JSR JSTS2 ;IF BEYOND LENGTH BUT NOT AT POS. 79 ;INSERT NEW LINE JMP LOOP2 ;AND EXIT;**********************************;*                                *;* GET OR INSERT NEW LINE.        *;*                                *;**********************************SCRL JSR SCROL ;SCROLL LINES ON SCREEN DEC LXSP ;DECREMENT COPY OF LINE NUMBER DEC TBLX ;AND LINE# ITSELF (CURSOR ON SAME LINE) LDX TBLX ;GET LINE NUMBERJSTS2 ASL LDTB1+1,X LSR LDTB1+1,X ;SET LINE TO 'EXTENDED' JSR JSTSX ;AND NEXT LINE TO 'NOT-EXTENDED' LDA PNTR ;SAVE POSITION PHA JSR STUPT ;AND SET POINTER PLA STA PNTR ;AND RESTORE POSITION RTS;**********************************;*                                *;* BACKWARD OVER LINE BOUNDARY.   *;*                                *;**********************************BKLN LDY #39 ; LDX TBLX ;IF CURRENT LINE BNE BKLN1 ;IS TOP LINE STX PNTR ;SET CURSOR HOME PLA PLA ;REMOVE RETURN ADDRESS BNE LOOP2 ;AND EXITBKLN1 LDA LDTB1-1,X ;IF NOT ON TOP LINE BMI NTCN2 ;AND LINE IS 'EXTENDED' DEX LDA LDTB1-1,X ;GET INDICATOR OF NEXT LINE LDY #79 ;AND SET POSITION TO 79NTCN2 DEX ;ADAPT LINE NUMBER STX TBLX ;AND STORE IT STA PNT+1 ;AND STORE NEW POINTER LDA LDTB2,X ;STORE LO-BYTE STA PNT ;AS WELL STY PNTR ;SET CURSOR AT END OF LINE STY LNMX ;AND SET LENGTH TO 79 RTS;**********************************;*                                *;* PUT CHARACTER TO SCREEN.       *;*                                *;**********************************PRT PHA ;SAVE A STA DATA ;ALSO IN TEMPORARY FIELD TXA PHA ;SAVE X TYA PHA ;AND Y LDA #0 STA CRSW ;SET COPY OF POSITION TO ZERO LDY PNTR ;GET POSITION LDA DATA ;GET CHARACTER AGAIN AND #$7F ;REMOVE SHIFT BIT CMP #$1B ;IF ESC OF SHIFT-ESC BNE E21A ;NOT ON KEYBOARD AND NOT IN KEYBOARD TABLE! JMP NXTL ;CANCEL QUOTE MODEE21A LDA DATA ;GET CHARACTER AGAIN BPL E221 ;IF SHIFTED JMP NXTX ;GO DO SHIFTED CHARACTERE221 CMP #$0D ;IF RETURN BNE NJTL JMP E3BF ;GO DO RETURNNJTL CMP #$20 ;IF PRINTABLE BCC NTCN AND #$3F ;CONVERT TO SCREEN CODE JSR QTSWC ;CHECK FOR QUOTE MODE JMP NXT3 ;AND PUT TO SCREENNTCN LDX INSRT ;IF INSERTS OUTSTANDING BEQ CNC3X JMP NC3 ;PRINT AS CONTROL CHARACTERCNC3X CMP #$14 ;IF DELETE BNE NTCN1 DEY ;DECREMENT CHARACTER POSITION STY PNTR ;AND STORE IT BPL BK1 ;IF GONE TO PREVIOUS LINE JSR BKLN ;GO DO APPROPRIATE ACTION JMP BK2 ;AND INSERT BLANK AT ENDBK1 INY ;ELSE LDA (PNT),Y ;COMPRESS DEY ;LINE STA (PNT),Y ;UPTO INY ;END OF CPY LNMX ;LINE BNE BK1BK2 LDA #$20 ;AND INSERT BLANK STA (PNT),Y ;AT END BNE NCZ2NTCN1 LDX QTSW ;IF IN QUOTE MODE BEQ NC3WCNC3 JMP NC3 ;PRINT AS CONTROL CHARACTERNC3W CMP #$12 ;IF RVS-ON BNE NC1 STA RVS ;SET REVERSE FLAG BEQ NCZ2 ;WHY NOT BRANCH DIRECTLY?NC1 CMP #$13 ;IF HOME BNE NC2 JSR NXTD ;SET CURSOR HOMENC2 CMP #$1D ;IF CURSOR-RIGHT BNE NCX2 INY STY PNTR ;ADVANCE CURSOR DEY CPY PNT+1 ;IF AT LINE END BCC NCZ2 JSR NXLN ;GO TO NEXT LINE LDY #$00 ;SET CURSOR AT BEGINNINGJPL4 STY PNTR ;STORE POSITIONNCZ2 JMP LOOP2 ;AND EXITNCX2 CMP #$11 ;IF CURSOR-DOWN BNE E29C CLC TYA ADC #40 ;ADD 40 TO POSITION TAY CMP LNMX ;IF NOT BEYOND LENGTH BCC JPL4 ;GO STORE POSITION BEQ JPL4 ;IF AT END ALSO JSR NXLN ;ELSE GOTO NEXT LINEJPL3 JMP LOOP2 ;AND EXITE29C CMP #$16 ;IF ERASE TO END OF LINE BNE E2AC LDA #$20 ;GET BLANK DEYE2A3 INY STA (PNT),Y ;FILL LINE WITH BLANKS CPY LNMX ;UNTIL THE END BCC E2A3 BCS JPL3 ;IF AT END, EXITE2AC CMP #$0E ;IF TEXT BNE E2B5 JSR E60F ;SET TO TEXT MODE BMI JPL3 ;AND EXITE2B5 CMP #$07 ;IF BELL BNE E2BE JSR E657 ;RING BELL ONCE BEQ JPL3 ;AND EXITE2BE CMP #$09 ;IF NOT TAB BNE JPL3 ;IGNOREE2C2 CPY LNMX ;IF TAB AND AT END OF LINE BCC E2CD LDY LNMX ;GET LENGTHE2C8 STY PNTR ;AND SET CURSOR THERE JMP LOOP2 ;AND EXITE2CD INY ;CHECK NEXT POSITION JSR E588 ;GET NEXT TABSTOP BEQ E2C2 ;IF NO TABSTOP, RETRY FOR NEXT COLUMN BNE E2C8 ;IF TABSTOP FOUND SET CURSOR THERE ;