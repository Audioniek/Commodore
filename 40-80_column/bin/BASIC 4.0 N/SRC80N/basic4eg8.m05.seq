;NAME "@1:BASIC4EG8.M05";**********************************;*                                *;* SCAN KEYBOARD.                 *;*                                *;**********************************KEYSCN LDY #$FF ;THIS INDEX RECEIVED STY SFDX ;ON NO KEY AT ALL INY STY SHFLAG ;CLEAR SHIFT KEY INDICATOR NOP ;TEST FOR KEY REPEAT NOP ;WAS HERE NOP NOP NOP NOP LDX #80 ;THIS NUMBER OF KEYS TO BE DONEE4CD LDY #8 ;NUMBER OF BITS LDA PIAK ;GET KEY IMAGE CMP PIAK ;WAIT BNE E4CD ;UNTIL STEADYKL1 LSR A ;GET BIT IN CARRY BCS CKIT ;IF KEY PRESSED PHA ;SAVE KEY IMAGE LDA CHAR-1,X ;GET VALUE FOR THAT KEY BNE CKIS1 ;IF SHIFT KEY LDA #1 STA SHFLAG ;SET FLAG FOR SHIFT KEY BNE CKUT ;AND LOOPCKIS1 CMP #$FF ;IF NO KEY BEQ CKUT ;CHECK FOR NEXT KEY STA SFDX ;ELSE STORE KEY VALUECKUT PLA ;REGET KEY IMAGECKIT DEX ;DECREMENT KEY COUNTER BEQ CKIT1 ;IF NOT AT END DEY ;DECREMENT BIT COUNTER BNE KL1 ;AND CHECK NEXT BITS INC PIAL ;DO NEXT SCAN LINE BNE E4CD ;AND LOOPCKIT1 LDX #16 ;GET COUNTDOWN LDA SFDX ;GET KEY FOUND CMP #$FF ;IF NO KEY BEQ E528 ;EXIT CMP NEWKEY ;IF SAME AS LAST TIME BNE E528 ;DO REPEAT BIT RPTFLG ;TEST REPEAT FLAG BVS E552 ;IF REPEAT OFF, EXIT BPL E51A ;IF REPEAT ON, GO REPEAT CMP #$14 ;ELSE IF INST/DEL BEQ E51A ;DO REPEAT CMP #$20 ;IF SPACE BEQ E51A ;DO REPEAT CMP #$1D ;IF LEFT/RIGHT BEQ E51A ;DO REPEAT CMP #$11 ;IF NOT UP/DOWN BNE E552 ;EXITE51A LDY KBFPTR ;GET # OF KEYS IN BUFFER DEY BPL E552 ;IF NOT EMPTY, EXIT DEC RPTCNT ;DECREMENT COUNTDOWN/DELAY BNE E552 ;IF NOT EXPIRED, EXIT LDX #1 ;ELSE STX BLNCT ;STORE NEW FLASH COUNTDOWN INXE528 STX RPTCNT ;RELOAD DELAY STA NEWKEY ;STORE NEW KEY VALUE CMP #$FF ;IF NO KEY BEQ E552 ;EXIT PHP ;SAVE FLAGS AND #$7F ;REMOVE SHIFT BIT PLP ;GET FLAGS AGAIN BMI KN1 ;IF MSB WAS SET, IGNORE MSB LSR SHFLAG ;GET AND CLEAR SHIFT STATUS BCC KN1 ;IF PRESSED ORA #$80 ;ADD SHIFT BITKN1 LDX KBFPTR ;GET # OF KEYS IN BUFFER CPX KBFLIM ;IF EQUAL OR MORE THAN MAX. LENGTH BCS E552 ;EXIT (IGNORE KEY) CMP #3 ;IF STOP KEY BNE E54C LDY #0 STY QTSW ;CANCEL QUOTE MODE STY INSRT ;AND ZERO INSERTS OUTSTANDINGE54C STA KEYBUF,X ;ELSE STORE IN BUFFER INX STX KBFPTR ;AND ADAPT BUFFER COUNTERE552 RTS; * = $E570 ;KEEP GETTAB ON SAME ADDRESS;**********************************;*                                *;* GET BITMASK FOR TAB TABLE IN   *;* BITMSK AND OFFSET IN TABLE IN  *;* X.                             *;*                                *;**********************************GETTAB LDA PNTR ;GET COLUMN # AND #$F8 ;REMOVE 3 LOWEST BITS STA TABPOS ;SAVE IT LSR A LSR A LSR A ;DIVIDE IT BY 8 TAX ;AND MOVE TO X LDA #1 ;LOAD BIT MASK STA BITMSK LDY PNTR ;GET COLUMN # AGAINTABOK CPY TABPOS ;IF POSITION FOUND BEQ RTSTAB ;EXIT ASL BITMSK ;ADAPT BIT MASK INC TABPOS ;AND COUNT BITS JMP TABOK ;UNTIL POSITION FOUNDRTSTAB RTS;