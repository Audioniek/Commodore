;NAME "@1:BASIC4EF4B.M05";**********************************;*                                *;* THE AREA $E59E-$E5FF IS FILLED *;* WITH $AA BYTES.                *;*                                *;********************************** * = $E600;**********************************;*                                *;* EXIT FROM INTERRUPT.           *;*                                *;**********************************PREND PLA TAY ;RESTORE Y PLA TAX ;AND X PLA ;AND A RTI ;AND RETURN FROM INTERRUPT;**********************************;*                                *;* STORE THE CHARACTER IN A       *;* ON SCREEN.                     *;*                                *;**********************************DSPP LDY PNTR ;GET CURSOR POSITION ON LINE STA (PNT),Y ;STORE THE CHARACTER LDA #2 ;AND SET UP NEW COUNTDOWN STA BLNCT ;FOR CURSOR FLASH RTS;**********************************;*                                *;* SET CRT-CONTROLLER TO TEXT     *;* MODE.                          *;*                                *;**********************************E60F LDA #<TEXT LDX #>TEXT ;LOAD POINTER TO CONSTANTS LDY #$0E ;LOAD VIA REG. VALUE FOR TEXT BNE E61D ;AND MOVE CONSTANTS;**********************************;*                                *;* SET CRT-CONTROLLER TO GRAPHICS *;* MODE.                          *;*                                *;**********************************E617 LDA #<GRAF LDX #>GRAF ;LOAD POINTER TO CONSTANTS LDY #$0C ;AND VIA REG. VALUE FOR GRAPHICSE61D STA SAL STX SAH ;STORE POINTER LDA PCR ;GET VIA REGISTER AND #$F0 ;CLEAR LOWER NIBBLE STA FNLEN ;SAVE IT TYA ;GET NIBBLE FOR CHARACTERGENERATOR ORA FNLEN ;ADD HI-NIBBLE STA PCR ;AND SET UP CHARACTERGENERATOR LDY #17 ;18 CONSTANTS TO BE MOVEDE630 LDA (SAL),Y ;GET CONSTANT STY CR0 ;SET REGISTER NUMBER STA CR1 ;AND SET UP THAT REGISTER DEY BPL E630 ;AND DO ALL REGISTERS RTS;**********************************;*                                *;* RING BELL IF RIGHT MARGIN      *;* PASSED.                        *;*                                *;**********************************E63C JSR PRT ;MOVE CHARACTER TO SCREEN TAX ;SAVE IT IN X LDA LNMX ;GET LENGTH OF LINE SEC SBC PNTR ;SUBTRACT CURRENT POSITION CMP #5 ;IF 5 FROM MARGIN BNE E682 TXA ;GET CHARACTER AGAIN CMP #$1D ;IF CURSOR-RIGHT BEQ E654 ;RING BELL TWICE AND #$7F ;REMOVE SHIFT-BIT CMP #$20 ;IF NOT PRINTABLE BCC E682 ;EXIT, ELSE RING BELL TWICE;**********************************;*                                *;* RING BELL TWICE.               *;*                                *;**********************************E654 JSR E657 ;RING BELL ONCE;**********************************;*                                *;* RING BELL ONCE.                *;*                                *;**********************************E657 LDY $03EC ;GET BELL TIMING BEQ E682 ;IF ZERO, DON'T RING BELL LDA #$10 ;SET CB2 TO FREE RUN STA ACR LDA #$0F ;AND TO LOWEST FREQUENCY STA SR LDX #7 ;7 TONES TO PLAYE668 LDA TONES-1,X ;GET TONE CONSTANT STA T2L ;PUT TO VIA LDA $03EC ;GET TIMINGE671 DEY BNE E671 ;WAIT, INNER LOOP SEC SBC #1 BNE E671 ;WAIT, OUTER LOOP DEX BNE E668 ;AND DO NEXT TONE STX SR ;THEN SILENCE THE VIA STX ACR ;AND ENABLE CASSETTE OPERATIONSE682 RTS ;THEN EXIT;**********************************;*                                *;* RESET; INITIALIZE I/O.         *;*                                *;**********************************E683 LDA #$7F STA IER ;DISABLE ALL VIA INTERRUPTS LDX #$6D LDA #$00 ;CLEARPX1 STA CTIMR,X ;AREA $8D TO $FA DEX BPL PX1 LDX #10E693 STA $03F0,X ;CLEAR TABSTOP TABLE DEX BPL E693 STA RPTFLG ;ENABLE REPEAT OF CURSOR KEYS LDA #<KEY ;SET STA CINV ;IRQ RAM VECTOR LDA #>KEY ;TO STA CINV+1 ;KEYBOARD/CASSETTE ROUTINE LDA #3 ;SET DEFAULT OUTPUT DEVICE STA DFLTO ;TO SCREEN LDA #$0F ;KEYBOARD PIA, A SECTION: STA PIAL ;BITS 0-3 OUTPUT, REST INP ASL A STA PIA ;CASSETTE#2 MOTOR OFF ;CASSETTE #1 AND #2 WRITE = 1 ;IEEE ATN=FALSE  NRFD=FALSE STA P2DB ;VIA A: BITS 7-5,0 OUTPUT, 4-1 INPUT STX IEEO ;IEEE PIA, B SECTION: ALL BITS OUTPUT STX T1H ;VIAT1H: MAXIMUM TIMEOUT LDA #$3D ;KEYBOARD PIA: CASSETTE#1 MOTOR OFF STA PIAS ;IRQ ON NEG EDGE ON CB1 ;(END OF SCREEN REFRESH) BIT PIAK ;CLEAR KEYBOARD PIA INTERRUPT FLAGS LDA #$3C ;IEEE PIA: NDAC=FALSE, CA1 NEG. EDGE STA IEEIS ;NO INTERRUPTS STA IEEOS ;IEEE PIA: DAV=FALSE, CB1 NEG. EDGE ;NO INTERRUPTS STA PIAL1 ;KEYBOARD PIA: CA2=1,CA1 NEG. EDGE ;NO INTERRUPTS STX IEEO ;IEEE PIA: ALL DATA LINES FALSE LDA #$0C ;VIA:CA2=0 (GRAPHICS), CA1NEG. EDGE STA PCR ;NO INTERRUPTS,CB2 INPUT,NEG. EDGE STA BLNCT ;SET BLINK COUNT FOR CURSOR STA BLNSW ;SET CURSOR VISIBLE LDA #9 ;DEFAULT KEYBOARD BUFFER LENGTH ;BUG: MUST BE 10 FOR BUFFERLENGTH OF 10 STA XMAX LDA #$10 STA $03EC ;SET UP BELL TIMING, STA DELAY ;REPEAT DELAY STA KOUNT ;AND REPEAT RATE RTS ;THEN EXIT;**********************************;*                                *;* SCROLL REST OF SCREEN DOWN     *;* AND INSERT A BLANK LINE ON     *;* CURSOR'S LINE.                 *;*                                *;**********************************NEWLN LDX TBLX ;GET CURRENT LINE NUMBER INX CPX #24 ;IF ON LAST LINE BUT ONE BEQ BLKLN ;BLANK THIS LINE BCC NEWLX ;IF ON LAST LINE JMP SCRL ;INSERT A LINENEWLX LDX #23 ;ELSE START WITH BOTTOM LINENEXL1 LDA LDTB1+1,X ORA #$80 ;ADD MSB STA SAH ;AND SET UP POINTER LDY LDTB1,X ;GET PREVIOUS LINEMARKER BMI NEWLA ;IF 'EXTENDED' AND #$7F ;REMOVE MSBNEWLA STA LDTB1+1,X ;AND PUT IN TABLE TYA ;MOVE MARKER OF PREVIOUS LINE ORA #$80 ;ADD MSB STA PNT+1 ;AND SET UP POINTER LDY #39 ;40 CHARACTERS TO BE MOVED LDA LDTB2+1,X ;GET LO-BYTE OF LOWER LINE STA SAL ;COMPLETE POINTER LDA LDTB2,X ;GET LO-BYTE OF UPPER LINE STA PNT ;COMPLETE POINTERNELL LDA (PNT),Y ;GET CHARACTER OF UPPER LINE STA (SAL),Y ;STORE IN LOWER LINE DEY BPL NELL ;REPEAT UNTIL ALL CHAR.S MOVED DEX ;IF NOT ALL LINES DONE CPX TBLX BNE NEXL1 ;REPEAT FOR OTHER LINES INXBLKLN LDA LDTB1,X ;GET MARKER OF TOP LINE ORA #$80 ;ADD MSB STA PNT+1 ;SET UP POINTER AND #$7F ;SET LINE 'EXTENDED' STA LDTB1,X ;INTO TABLE LDA LDTB2,X ;GET LO-BYTE STA PNT ;COMPLETE POINTER LDY #39 LDA #$20 ;GET BLANKBLKL STA (PNT),Y ;FILL TOP LINE WITH BLANKS DEY BPL BLKL ;UNTIL WHOLE LINE FILLED JMP STUPT ;AND GET POINTER TO CURRENT LINE ;