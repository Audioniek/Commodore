;NAME "@1:BASIC4EF4B.M01";**********************************;*                                *;* JUMP MENU, ENABLES STANDARDI-  *;* SATION BETWEEN VARIOUS MACHINE *;* TYPES (COMPATIBLE WITH 8032).  *;*                                *;**********************************CINT JMP CINT1 ;INITIALIZE I/O, CURSOR HOME, 4 BELLS JMP LP2 ;GET CHARACTER FROM KEYBOARD BUFFER JMP LOOP5 ;GET CHARACTER FROM DEVICE 0 OR 3 JMP PRT ;PUT CHARACTER TO SCREEN JMP PULS ;SERVICE INTERRUPT JMP KEY ;DEFAULT INTERRUPT ROUTINEPREND0 JMP PREND ;EXIT FROM INTERRUPT JMP CLSR ;CLEAR SCREEN JMP E60F ;SET TO LOWER/UPPER CASE JMP E617 ;SET TO UPPER CASE/GRAPHICS JMP E61D ;OTHER CRT CONTROLLER SETTINGS JMP NEWLN ;SCROLL SCREEN DOWN JMP SCROL ;SCROLL SCREEN UP JMP E4BF ;FIND KEY FROM DECODING TABLE JMP E657 ;RING BELL ONCE JMP STUPR ;(STORE ACCU IN REPEAT FLAG) JMP STUPR ;(SET TOP LEFT OF WINDOW) JMP STUPR ;(SET RIGHT BOTTOM OF WINDOW);**********************************;*                                *;* RESET ROUTINE.                 *;*                                *;**********************************CINT1 JSR E683 ;INITIALIZE I/O AND ZERO PAGE JSR E60F ;SET CRT CONTROLLER TO TEXT MODE JSR E654 ;RING BELL TWICE JSR E654 ;RING BELL TWICE;**********************************;*                                *;* INITIALIZE SCREEN (CLEAR IT).  *;*                                *;**********************************CLSR LDX #24 ;DO 25 LINES LDA #$C0 ;GET LO-BYTE OF LAST SCREEN LINE LDY #$83 ;GET HI-BYTE ALSOLPS1 STY LDTB1,X ;STORE HI-BYTE IN TABLE SEC SBC #40 ;CALCULATE NEW LO-BYTE BCS LPS3 ;IF PAGE CROSSED DEY ;ADAPT HI-BYTELPS3 DEX ;ADAPT LINE COUNTER BPL LPS1 ;IF ALL LINES DONE STY PNT+1 ;SET POINTER IN ($C4) INX ;MAKE X ZERO STX RVS ;SET RVS OFF STX PNT ;AND STORE LO-BYTE OF POINTER LDA #$20 ;PUT A BLANKLPS4 STA $8000,X ;INTO ALL BYTES STA $8100,X ;OF SCREEN STA $8200,X STA $8300,X INX BNE LPS4 ;UNTIL WHOLE SCREEN DONENXTD LDY #$00 STY PNTR ;SET CURSOR ON START OF LINE STY TBLX ;AND ON FIRST SCREEN LINE;**********************************;*                                *;* GET POINTER TO CURRENT LINE IN *;* SCREEN RAM.                    *;*                                *;* EXPECTS $D8 TO CONTAIN CURRENT *;* LINE NUMBER; ($C4) WILL BE SET *;* TO POINT TO CURRENT LINE; $D5  *;* WILL BE SET TO MAX. LENGTH OF  *;* THAT LINE.                     *;*                                *;**********************************STUPT LDX TBLX ;GET SCREEN LINE OF CURSOR LDA LDTB1,X ;GET HI-BYTE OF THAT LINE ORA #$80 ;SET BIT 7 (FLAG IN TABLE) STA PNT+1 ;AND STORE IN POINTER LDA LDTB2,X ;GET LO-BYTE FROM TABLE STA PNT ;STORE IN POINTER TOO LDA #39 ;SET LENGTH TO 39 STA LNMX CPX #24 ;IF NOT BOTTOM LINE BEQ STUPZ LDA LDTB1+1,X ;AND BIT 7 FROM TABLE CLEAR BMI STUPZ LDA #79 ;THEN LENGTH IS 79 STA LNMXSTUPZ LDA PNTR ;GET POSITION ON LINE CMP #40 BCC STUPR SBC #40 STA PNTR ;AND STORE MODULO 40STUPR RTS* = $E0A7;**********************************;*                                *;* GET CHARACTER FROM KEYBOARD    *;* BUFFER.                        *;*                                *;**********************************LP2 LDY KEYD ;GET OLDEST CHARACTER LDX #$00LP1 LDA KEYD+1,X ;MOVE REST OF BUFFER STA KEYD,X ;FORWARD INX CPX NDX ;UNTIL ALL  CHAR'S DONE BNE LP1 DEC NDX ;ADAPT INDEX IN BUFFER TYA ;GET CHARACTER IN ACCU CLI ;ENABLE INTERRUPTS AGAIN RTS;**********************************;*                                *;* WAIT FOR RETURN FROM KEYBOARD. *;*                                *;**********************************LOOP4 JSR E63C ;ECHO CHARACTER ON SCREENLOOP3 LDA NDX ;GET INDEX IN KEYB. BUFFER STA BLNSW ;IF EMPTY, SET CURSOR VISIBLE BEQ LOOP3 ;ELSE WAIT FOR CHARACTER SEI ;DISABLE INTERRUPTS LDA BLNON ;IF BLINK FASE ONE BEQ LP21 LDA GDBLN ;GET TRUE CHAR. AT CURSOR POSITION LDY #$00 STY BLNON ;SET BLINK FASE ZERO JSR DSPP ;AND PUT CHAR TO SCREENLP21 JSR LP2 ;GET CHARACTER FROM BUFFER CMP #$83 ;IF SHIFT-STOP BNE LP22 SEI ;DISABLE INTERRUPTS LDX #9 STX NDX ;SET INDEX IN BUFFER TO 9LP23 LDA RUNTB-1,X ;MOVE STANDARD STRING STA KEYD-1,X ;TO BUFFER DEX BNE LP23 BEQ LOOP3 ;AND GET 1ST CHAR. OF THAT STRINGLP22 CMP #$0D ;IF IS NOT RETURN BNE LOOP4 ;GO ECHO TO SCREEN AND GET NEXT CHAR LDY LNMX ;ELSE GET MAX. LENGTH STY CRSW ;FLAG INPUT FROM SCREENCLP5 LDA (PNT),Y ;GET CHAR. FROM SCREEN CMP #$20 ;IF SPACE AT END OF LINE BNE CLP6 DEY ;GET PREVIOUS CHARACTER BNE CLP5CLP6 INY STY INDX ;SET RECORD LENGTH OF CURRENT LINE LDY #$00 STY PNTR ;AND SET CURSOR AT START  OF LINE STY QTSW ;CLEAR QUOTE FLAG LDA LXSP ;GET LINE NUMBER ON SCREEN BMI LOP5 ;IF VALID CMP TBLX ;AND EQUAL TO ORIGINAL BNE LOP5 LDA LXSP+1 ;SET POSITION STA PNTR ;TO ORIGINAL VALUE CMP INDX ;IF NOT BEHIND END OF RECORD BCC LOP5 ;GET CHAR FROM DEVICE 3 BCS CLP2 ;ELSE RETURN RETURN;**********************************;*                                *;* GET CHARACTER FROM DEVICE 0    *;* OR DEVICE 3.                   *;*                                *;**********************************LOOP5 TYA PHA ;SAVE Y TXA PHA ;SAVE X LDA CRSW ;IF INPUT FROM KEYBOARD BEQ LOOP3 ;GO DO KEYBOARD UNTIL RETURN;**********************************;*                                *;* GET CHARACTER FROM CURRENT     *;* SCREEN LINE.                   *;*                                *;**********************************LOP5 LDY PNTR ;GET CURRENT POSITION LDA (PNT),Y ;GET SCREEN CHARACTER STA DATA ;SAVE ITLOP51 AND #$3F ;REMOVE BITS 6 AND 7 ASL DATA BIT DATA ;IF ORIGINAL BIT 6 SET BPL LOP54 ORA #$80 ;SET BIT 7 (SHIFT BIT)LOP54 BCC LOP52 ;IF ORIGINAL BIT 7 SET LDX QTSW ;AND IF IN QUOTE MODE BNE LOP53 ;DON'T CHANGE BIT 6LOP52 BVS LOP53 ;ELSE IF BIT 5 SET IN ORIGINAL ORA #$40 ;SET BIT 6LOP53 INC PNTR ;ADAPT POSITION JSR QTSWC ;ADAPT QUOTE FLAG CPY INDX ;IF MAX POSITION REACHED BNE CLP1CLP2 LDA #$00 STA CRSW ;FLAG INPUT FROM KEYBOARD LDA #$0D ;AND ECHO RETURN LDX DFLTN ;IF INPUT DEVICE CPX #3 ;IS SCREEN BEQ CLP2A ;GO ECHO ON SCREEN LDX DFLTO ;ELSE IF OUTPUT DEVICE CPX #3 ;IS SCREEN BEQ CLP21 ;STORE RETURN IN LAST INPUTCLP2A JSR PRT ;ECHO ON SCREENCLP21 LDA #$0D ;AND STORE A RETURNCLP1 STA DATA ;IN LAST KEY INPUT PLA TAX ;RESTORE X PLA TAY ;RESTORE Y LDA DATA ;GET CHARACTER AGAIN CMP #$DE ;IF CODE FOR PI BNE CLP7 LDA #PI ;GET REAL CODE FOR PICLP7 RTS ;