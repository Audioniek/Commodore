;NAME "@1:BASIC4EG8.M03" * = $E202 ;FIXED ADDRESS IN F-ROM;**********************************;*                                *;* PUT CHARACTER TO SCREEN.       *;*                                *;**********************************PRT PHA ;SAVE CHARACTER STA DATA ;ALSO IN TEMPORARY FIELD TXA PHA ;SAVE X TYA PHA ;AND Y JMP (VOUT) ;AND GO OUTPUT (DEFAULT PRT55)PRT55 LDA #0 STA CRSW ;SET COPY OF POSITION TO ZERO LDY PNTR ;GET POSITION NOP ;TEST FOR ESC NOP ;USED TO BE NOP ;HERE, TO CANCEL NOP ;QUOTE MODE NOP ;IN THIS ROM NOP ;THIS IS NOP ;ACHIEVED BY NOP ;THE STOP KEY NOP ;IN THE INTERRUPT NOP ;ROUTINE NOP LDA DATA ;GET CHARACTER BPL PRT570 ;IF SHIFTED JMP NXTX ;GO DO SHIFTED CHARACTERPRT570 CMP #$0D ;IF RETURN BNE NJTL JMP NXT1 ;GO DO RETURNNJTL CMP #$20 ;IF PRINTABLE BCC NTCN AND #$3F ;CONVERT TO SCREEN CODE JSR QTSWC ;CHECK FOR QUOTE MODE JMP NXT3 ;AND PUT TO SCREENNTCN LDX INSRT ;IF INSERTS OUTSTANDING BEQ CNC3X JMP NC3 ;PRINT AS CONTROL CHARACTERCNC3X CMP #$14 ;IF DELETE BNE NTCN1 LDY SCLF ;GET LEFT MARGIN CPY PNTR ;IF CURSOR AFTER THAT BCC BK0 ;GO MOVE CURSOR LEFT JSR BKLN ;ELSE GO BACKWARD OVER BOUNDARY BNE BK2 ;AND ADD A BLANK AT THE ENDBK0 DEC PNTR ;MOVE CURSOR LEFT LDY PNTRBK1 INY ;ELSE LDA (PNT),Y ;COMPRESS DEY ;LINE STA (PNT),Y ;UPTO INY ;END OF CPY SCRT ;RIGHT MARGIN BNE BK1BK2 LDA #$20 ;AND INSERT BLANK STA (PNT),Y ;AT END BNE JPL3NTCN1 LDX QTSW ;IF IN QUOTE MODE BEQ NC3WCNC3 JMP NC3 ;PRINT AS CONTROL CHARACTERNC3W CMP #$12 ;IF RVS-ON BNE NC1 STA RVS ;SET REVERSE FLAGNC1 CMP #$13 ;IF HOME BNE NC2 LDA FHOME ;GET HOME COUNTER BPL NC100 ;IF SECOND HOME JSR SRESET ;SET WINDOW TO FULL SCREEN CLCNC100 ROR FHOME ;ADJUST COUNTER JSR NXTD ;AND SET CURSOR TO TOP LEFT JMP LOPII ;AND EXITNC2 CMP #$1D ;IF CURSOR-RIGHT BNE NCX2 INY STY PNTR ;ADVANCE CURSOR DEY CPY SCRT ;IF AT RIGHT MARGIN BCC JPL3 JMP JSTS1 ;GO TO NEXT LINE AND EXITNCX2 CMP #$11 ;IF CURSOR-DOWN BNE TABCHK JSR NXLN ;MOVE CURSOR DOWN AND SCROLL IF NECESSARYJPL3 JMP LOOP2 ;AND EXITTABCHK CMP #$09 ;IF TAB BNE ERASTO JSR GETTAB ;GET BITMASK AND OFFSETTAB1 LDY TABPOS ;GET POSITION OF NEXT TAB INC TABPOS CPY SCRT ;IF AFTER RIGHT MARGIN BCC TAB2 LDA SCRT ;GET RIGHT MARGIN STA PNTR ;PUT CURSOR THERE DEC TABPOS BNE JPL3 ;AND EXITTAB2 ASL BITMSK ;ELSE ADAPT BITMASK BNE TAB3 ;IF BYTE EXCEEDED INX ;ADAPT INDEX CPX #10 ;IF AT LAST POSSIBLE INDEX BEQ JPL3 ;EXIT LDA #1 ;ELSE SET UP STA BITMSK ;NEW BITMASKTAB3 LDA TAB,X ;GET TABSTOPBYTE AND BITMSK ;TEST MASK, IF NO TABSTOP BEQ TAB1 ;CHECK NEXT COLUMN INY ;ELSE STY PNTR ;PUT CURSOR THEREERASTO CMP #$16 ;IF ERASE TO END OF LINE BNE DLINE LDA #$20 ;GET BLANK DEY ;ERASE CURSOR'S POSITION ALSOERT10 INY ;WHY NOT USE XWRTC1? STA (PNT),Y ;FILL LINE WITH BLANKS CPY SCRT ;UNTIL RIGHT MARGIN REACHED BCC ERT10 BCS JPL3 ;IF AT END, EXITDLINE CMP #$15 ;IF NOT DELETE LINE BEQ DLN10 JMP SCTUP ;DO REST OF CONTROL CHARSCTERSDLN10 LDA SCTOP ;ELSE GET TOP LINE # PHA ;SAVE IT LDA TBLX ;GET CURRENT LINE # STA SCTOP ;STORE IN TOP LINE # JSR SCRUP ;SCROLL REST OF WINDOW UP JMP ILN20 ;RESTORE TOP LINE # AND EXIT;**********************************;*                                *;* PUT SHIFTED CHARACTERS TO      *;* SCREEN.                        *;*                                *;**********************************NXTX AND #$7F ;REMOVE SHIFT BIT CMP #PI-$80 ;IF CODE FOR PI BNE NXTX1 LDA #$5E ;GET REAL CODE FOR PINXTX1 CMP #$20 ;IF PRINTABLE BCC UP4 JMP NXT33 ;GO FILL SCREENUP4 CMP #$0D ;IF SHIFT-RETURN BNE UP5 JMP NXT1 ;GO DO RETURNUP5 LDX QTSW ;IF QUOTE MODE BNE UP6 ;PRINT AS CONTROL CHARACTER CMP #$14 ;NO QUOTE MODE, IF INSERT BNE UP9 LDY SCRT ;GET RIGHT MARGIN LDA (PNT),Y ;GET LAST CHAR. OF LINE CMP #$20 ;IF BLANK BNE JPL2 CPY PNTR ;AND NOT ON LAST POSITION BCC JPL2 ;THEN ENOUGH SPACE ON LINE BEQ JPL2INS1 LDY SCRT ;GET RIGHT MARGININS2 DEY ;MOVE LDA (PNT),Y ;CHARACTERS INY ;ONE POSITION STA (PNT),Y ;FURTHER DEY ;UNTIL CPY PNTR ;ALL DONE BNE INS2 LDA #$20 ;AND PUT A BLANK STA (PNT),Y ;IN SPACE OPENED UP LDA SCRT ;GET RIGHT MARGIN SEC SBC PNTR ;SUBTRACT POSITION SBC INSRT ;AND NUMBER OF INSERTS BMI JPL2 ;IF NOT POSITIVE, EXIT INC INSRT ;ELSE ADD AN INSERT BNE JPL2 ;AND EXITUP9 LDX INSRT ;IF INSERTS OUTSTANDING BEQ UP2UP6 ORA #$40 ;CONVERT TO SCREEN CODE JMP NC3 ;AND PRINT AS CONTROL CHAR.UP2 CMP #$11 ;IF CURSOR-UP BNE NXT2 LDX SCTOP ;GET TOP LINE # CPX TBLX ;IF ON TOP LINE OR ABOVE BCS JPL2 ;EXIT DEC TBLX ;ELSE MOVE CURSOR UP JSR STUPT ;GET POINTER TO NEW LINE BNE JPL2 ;AND EXITNXT2 CMP #$12 ;IF RVS-OFF BNE NXT6 LDA #$00 STA RVS ;RESET REVERSE FLAGNXT6 CMP #$1D ;IF CURSOR-LEFT BNE NXT61 LDY SCLF ;GET LEFT MARGIN CPY PNTR ;IF LEFT TO THAT BCC NXT8 JSR BKLN ;GO BACKWARD OVER BOUNDARY BNE JPL2 ;AND EXITNXT8 DEC PNTR ;ELSE MOVE CURSOR LEFT BPL JPL2 ;AND EXITNXT61 CMP #$13 ;IF CLR(-WINDOW) BNE TABSET JSR CLSR ;CLEAR THE WINDOW BNE JPL2 ;AND EXITTABSET CMP #$09 ;IF SHIFT-TAB BNE ERASF JSR GETTAB ;GET BITMASK AND INDEX LDA TAB,X ;GET TABSTOPBYTE EOR BITMSK ;ADD OR REMOVE BIT STA TAB,X ;STORE AGAINJPL2 JMP LOOP2 ;AND EXITERASF CMP #$16 ;IF NOT ERASE FROM START BEQ ERF050 JMP ILINE ;GO DO REST OF CHARACTERSERF050 LDA #$20 ;ELSE GET BLANK LDY SCLF ;START AT LEFT MARGINERF10 CPY PNTR ;IF CURRENT POSITION REACHED BCS JPL2 ;EXIT STA (PNT),Y ;ELSE STORE BLANK INY BNE ERF10 ;AND REPEAT;