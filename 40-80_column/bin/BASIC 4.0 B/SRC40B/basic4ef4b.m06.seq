;NAME "@1:BASIC4EF4B.M06";**********************************;*                                *;* KEYBOARD TABLE, FOR 80 KEYS.   *;*                                *;* KEYS WITH MSB SET HAVE NO      *;* SHIFTED EQUIVALENT, E.G. ALL   *;* THE NUMERALS.                  *;*                                *;**********************************CHAR .BYT $16, $04, ':', $03, '963', $DF ;SCAN LINE NINE .BYT $B1, '/', $15, $13, 'M X', $12 ;SCAN LINE EIGHT .BYT $B2, $10, $0F, $B0, ',NVZ' ;SCAN LINE SEVEN .BYT $B3, $00, $19, $AE, '.BC', $00 ;SCAN LINE SIX .BYT $B4, $DB, 'O', $11, 'UTEQ' ;SCAN LINE FIVE .BYT $14, 'PI', $DC, 'YRW', $09 ;SCAN LINE FOUR .BYT $B6, $C0, 'L', $0D, 'JGDA' ;SCAN LINE THREE .BYT $B5, ';K', $DD, 'HFS', $9B ;SCAN LINE TWO .BYT $B9, $06, $DE, $B7, $B0, '741' ;SCAN LINE ONE .BYT $05, $0E, $1D, $B8, '-852' ;SCAN LINE ZERO;**********************************;*                                *;* MESSAGE: D SHIFT-L "* RETURN   *;* RUN RETURN                     *;*                                *;**********************************RUNTB .BYT 'D', $CC, '"*', $0D, 'RUN', $0D;**********************************;*                                *;* TABLE OF LO-BYTES OF SCREEN    *;* LINE ADDRESSES.                *;*                                *;**********************************LDTB2 .BYT 0, 40, 80, 120, 160, 200, 240 .BYT 24, 64, 104, 144, 184, 224 .BYT 8, 48, 88, 128, 168, 208, 248 .BYT 32, 72, 112, 152, 192 .IFE HZ50 <;**********************************;*                                *;* TWO TABLES OF 18 CONSTANTS     *;* EACH FOR THE CRT-CONTROLLER.   *;* THE FIRST TABLE IS FOR TEXT    *;* MODE, THE SECOND FOR GRAPHICS  *;* MODE. TABLES ARE FOR 50 HZ     *;* FRAME RATE.                    *;*                                *;********************************** ;TEXT MODE TABLE, 50 HZTEXT .BYT 49 ;HORIZONTAL TOTAL .BYT 40 ;HORIZONTAL DISPLAYED .BYT 41 ;HORIZONTAL SYNC POSITION .BYT 15 ;HORIZONTAL SYNC WIDTH .BYT 39 ;VERTICAL TOTAL .BYT 0 ;VERTICAL TOTAL ADJUST .BYT 25 ;VERTICAL DISPLAYED .BYT 32 ;VERTICAL SYNC POSITION .BYT 0 ;INTERLACE MODE (OFF) .BYT 9 ;MAXIMUM SCAN LINE ADDRESS .BYT 0 ;CURSOR START .BYT 0 ;CURSOR END .BYT 16 ;START ADDRESS (HI) (INVERTS VIDEO) .BYT 0 ;START ADDRESS (LO) .BYT 0 ;CURSOR (HI) .BYT 0 ;CURSOR (LO) .BYT 0 ;LIGHT PEN (HI) .BYT 0 ;LIGHT PEN (LO) ;GRAPHICS MODE TABLE, 50 HZGRAF .BYT 49 ;HORIZONTAL TOTAL .BYT 40 ;HORIZONTAL DISPLAYED .BYT 41 ;HORIZONTAL SYNC POSITION .BYT 15 ;HORIZONTAL SYNC WIDTH .BYT 49 ;VERTICAL TOTAL .BYT 0 ;VERTICAL TOTAL ADJUST .BYT 25 ;VERTICAL DISPLAYED .BYT 37 ;VERTICAL SYNC POSITION .BYT 0 ;INTERLACE MODE (OFF) .BYT 7 ;MAXIMUM SCAN LINE ADDRESS .BYT 0 ;CURSOR START .BYT 0 ;CURSOR END .BYT 16 ;START ADDRESS (HI) (INVERTS VIDEO) .BYT 0 ;START ADDRESS (LO) .BYT 0 ;CURSOR (HI) .BYT 0 ;CURSOR (LO) .BYT 0 ;LIGHT PEN (HI) .BYT 0 ;LIGHT PEN (LO)> .IFN HZ50 <;**********************************;*                                *;* TWO TABLES OF 18 CONSTANTS     *;* EACH FOR THE CRT-CONTROLLER.   *;* THE FIRST TABLE IS FOR TEXT    *;* MODE, THE SECOND FOR GRAPHICS  *;* MODE. TABLES ARE FOR 60 HZ     *;* FRAME RATE.                    *;*                                *;**********************************;TEXT MODE TABLE, 60 HZTEXT .BYT 49 ;HORIZONTAL TOTAL .BYT 40 ;HORIZONTAL DISPLAYED .BYT 41 ;HORIZONTAL SYNC POSITION .BYT 15 ;HORIZONTAL SYNC WIDTH .BYT 32 ;VERTICAL TOTAL .BYT 3 ;VERTICAL TOTAL ADJUST .BYT 25 ;VERTICAL DISPLAYED .BYT 29 ;VERTICAL SYNC POSITION .BYT 0 ;INTERLACE MODE (OFF) .BYT 9 ;MAXIMUM SCAN LINE ADDRESS .BYT 0 ;CURSOR START .BYT 0 ;CURSOR END .BYT %00010000 ;START ADDRESS (HI) (INVERTS VIDEO) .BYT 0 ;START ADDRESS (LO) .BYT 0 ;CURSOR (HI) .BYT 0 ;CURSOR (LO) .BYT 0 ;LIGHT PEN (HI) .BYT 0 ;LIGHT PEN (LO) ;GRAPHICS MODE TABLE, 60 HZGRAF .BYT 49 ;HORIZONTAL TOTAL .BYT 40 ;HORIZONTAL DISPLAYED .BYT 41 ;HORIZONTAL SYNC POSITION .BYT 15 ;HORIZONTAL SYNC WIDTH .BYT 40 ;VERTICAL TOTAL .BYT 5 ;VERTICAL TOTAL ADJUST .BYT 25 ;VERTICAL DISPLAYED .BYT 33 ;VERTICAL SYNC POSITION .BYT 0 ;INTERLACE MODE (OFF) .BYT 7 ;MAXIMUM SCAN LINE ADDRESS .BYT 0 ;CURSOR START .BYT 0 ;CURSOR END .BYT %00010000 ;START ADDRESS (HI) (INVERTS VIDEO) .BYT 0 ;START ADDRESS (LO) .BYT 0 ;CURSOR (HI) .BYT 0 ;CURSOR (LO) .BYT 0 ;LIGHT PEN (HI) .BYT 0 ;LIGHT PEN (LO)> ;END OF 60 HZ TABLES;**********************************;*                                *;* CONSTANTS FOR BELL.            *;*                                *;**********************************TONES .BYT $0E, $1E, $3E, $7E, $3E, $1E, $0E;**********************************;*                                *;* TABLE OF BITMASKS FOR TABS.    *;*                                *;**********************************E7DC .BYT $80, $40, $20, $10, $08, $04, $02, $01;**********************************;*                                *;* CHECKSUM BYTE (OVER E-ROM).    *;*                                *;**********************************CKSUME .BYT $00 ;CHECKSUM BYTE;**********************************;*                                *;* COPYRIGHT STATEMENT.           *;*                                *;********************************** .BY ' (C) 2025 NDV FIRMWARE ';**********************************;*                                *;* THE REST OF THE ROM IS FILLED  *;* WITH $AA BYTES.                *;*                                *;********************************** ;